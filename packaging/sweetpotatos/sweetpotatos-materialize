#!/usr/bin/env bash
# Lay shipped SweetPotato desktop files into ~/.config without wiping user intent.
#
# - Clobbers files that exist under /usr/share/sweetpotato/config/
# - Never touches paths listed as seed-only if they already exist
# - Overlay ~/.config/sweetpotatos/user_edits/ wins over the shipped base
# - Always refreshes shipped wallpapers into the user wallpaper folders first
#   (before config copy), so a config cp failure cannot skip SpoNeon etc.
#   Never deletes extra user images; does not change waypaper's active choice
set -euo pipefail

BASE="${SWEETPOTATO_CONFIG_BASE:-/usr/share/sweetpotato/config}"
BACKGROUNDS_SRC="${SWEETPOTATO_BACKGROUNDS:-/usr/share/backgrounds/sweetpotatos}"
DEST="${XDG_CONFIG_HOME:-${HOME}/.config}"
OVERLAY="${DEST}/sweetpotatos/user_edits"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/sweetpotatos"
MANIFEST="${STATE_DIR}/materialized"

# Relative to DEST — copy from base only when missing.
SEED_ONLY=(
  kanshi/config
  swirl/config.d/user
)

wallpaper_dests() {
  local pictures
  pictures="${XDG_PICTURES_DIR:-${HOME}/Pictures}"
  printf '%s\n' \
    "${pictures}/Wallpapers" \
    "${HOME}/Pictures/Wallpapers" \
    "${HOME}/.local/share/backgrounds"
}

sync_wallpapers() {
  local src="${BACKGROUNDS_SRC}"
  local dest_dir
  local f
  local n
  local seen="|"

  if [[ ! -d "${src}" ]]; then
    echo "[!] No shipped wallpapers at ${src}" >&2
    return 0
  fi

  while IFS= read -r dest_dir; do
    [[ -n "${dest_dir}" ]] || continue
    # De-dupe when XDG_PICTURES_DIR is already ~/Pictures
    [[ "${seen}" == *"|${dest_dir}|"* ]] && continue
    seen="${seen}${dest_dir}|"

    mkdir -p "${dest_dir}"
    n=0
    shopt -s nullglob
    for f in "${src}"/*.png "${src}"/*.jpg "${src}"/*.jpeg "${src}"/*.webp; do
      [[ -f "${f}" ]] || continue
      cp -f "${f}" "${dest_dir}/"
      n=$((n + 1))
    done
    shopt -u nullglob
    if ((n > 0)); then
      echo "    Wallpapers → ${dest_dir} (${n} file(s))"
    fi
  done < <(wallpaper_dests)
}

# Wallpapers first — independent of config tree / copy errors.
sync_wallpapers

if [[ ! -d "${BASE}" ]]; then
  echo "[!] No shipped config at ${BASE} (install/upgrade sweetpotatos)." >&2
  exit 0
fi

mkdir -p "${DEST}" "${STATE_DIR}"
: >"${MANIFEST}.new"

is_seed_only() {
  local rel="$1"
  local s
  for s in "${SEED_ONLY[@]}"; do
    [[ "${rel}" == "${s}" ]] && return 0
  done
  return 1
}

copy_one() {
  local src="$1"
  local rel="${src#"${BASE}"/}"
  local out="${DEST}/${rel}"
  local over="${OVERLAY}/${rel}"

  if [[ -e "${over}" || -L "${over}" ]]; then
    mkdir -p "$(dirname "${out}")"
    cp -a "${over}" "${out}"
    printf '%s\n' "${rel}" >>"${MANIFEST}.new"
    return
  fi

  if is_seed_only "${rel}" && [[ -e "${out}" || -L "${out}" ]]; then
    printf '%s\n' "${rel}" >>"${MANIFEST}.new"
    return
  fi

  mkdir -p "$(dirname "${out}")"
  cp -a "${src}" "${out}"
  printf '%s\n' "${rel}" >>"${MANIFEST}.new"
}

while IFS= read -r -d '' src; do
  copy_one "${src}"
done < <(find "${BASE}" -type f -print0)

mv -f "${MANIFEST}.new" "${MANIFEST}"
echo "[+] Materialized shipped config into ${DEST}"
echo "    Overlay: ${OVERLAY}"
