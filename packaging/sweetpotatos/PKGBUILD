# Maintainer: visnudeva
pkgname=sweetpotatos
pkgver=2026.10.3
pkgrel=8
pkgdesc='SweetPotatOs system branding, hooks, helpers, and update channel'
arch=('any')
url='https://github.com/visnudeva/SweetPotatOs'
license=('MIT')
depends=('bash' 'pacman' 'plymouth' 'systemd' 'findutils' 'coreutils' 'python-gobject')
optdepends=(
  'swirl: desktop compositor'
  'yay-bin: AUR helper'
  'shelly-bin: package manager GUI'
  'localsend-bin: nearby file sharing'
  'spore: web radio and local music player'
  'tuber: light BitTorrent TUI client'
  'waypaper: wallpaper picker'
  'brave-origin-bin: default web browser (Mod+w)'
  'networkmanager-dmenu: Wi‑Fi tray icon and Mod+n'
)
install=sweetpotatos.install
source=(
  'sweetpotatos.install'
  'sweetpotatos.conf'
  'sweetpotatos-update'
  'sweetpotatos-materialize'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  local root="${SWEETPOTATOS_ROOT:-$(cd "${startdir}/../.." && pwd)}"
  local files="${startdir}/files"
  local ai="${root}/profile/airootfs"
  local skel="${ai}/etc/skel/.config"

  # System helpers live under packaging/sweetpotatos/files (not airootfs —
  # airootfs only keeps live-ISO-only tools so pacstrap can install this package).
  local bin
  for bin in \
    sweetpotatos-session \
    swirl \
    sweetpotatos-displays \
    sweetpotatos-branding \
    sweetpotatos-plymouth \
    sweetpotatos-fix-mkinitcpio \
    sweetpotatos-fix-ly \
    sweetpotatos-fix-sudo \
    sweetpotatos-fix-sway-keyboard; do
    install -Dm755 "${files}/usr/local/bin/${bin}" "${pkgdir}/usr/local/bin/${bin}"
  done

  install -Dm755 "${srcdir}/sweetpotatos-update" \
    "${pkgdir}/usr/local/bin/sweetpotatos-update"
  install -Dm755 "${srcdir}/sweetpotatos-materialize" \
    "${pkgdir}/usr/local/bin/sweetpotatos-materialize"

  install -Dm644 "${srcdir}/sweetpotatos.conf" \
    "${pkgdir}/etc/pacman.d/sweetpotatos.conf"

  install -Dm644 "${files}/usr/local/share/sweetpotatos/os-release" \
    "${pkgdir}/usr/local/share/sweetpotatos/os-release"
  install -Dm644 "${files}/usr/local/share/sweetpotatos/issue" \
    "${pkgdir}/usr/local/share/sweetpotatos/issue"
  install -Dm644 "${files}/usr/local/share/sweetpotatos/SPLogo.asc" \
    "${pkgdir}/usr/local/share/sweetpotatos/SPLogo.asc"
  install -Dm644 "${files}/usr/local/share/sweetpotatos/SPLogo.png" \
    "${pkgdir}/usr/local/share/sweetpotatos/SPLogo.png"

  local ply
  for ply in sweetpotatos.plymouth sweetpotatos.script \
             box.png bullet.png entry.png lock.png WhiteLogo.png; do
    install -Dm644 "${files}/usr/share/plymouth/themes/sweetpotatos/${ply}" \
      "${pkgdir}/usr/share/plymouth/themes/sweetpotatos/${ply}"
  done

  install -Dm644 "${files}/etc/systemd/logind.conf.d/lid-sleep.conf" \
    "${pkgdir}/etc/systemd/logind.conf.d/50-sweetpotatos-lid-sleep.conf"

  local hook
  for hook in \
    sweetpotatos-branding.hook \
    sweetpotatos-ly-swirl-session.hook \
    sweetpotatos-hide-sway-session.hook \
    89-sweetpotatos-plymouth.hook; do
    install -Dm644 "${files}/etc/pacman.d/hooks/${hook}" \
      "${pkgdir}/etc/pacman.d/hooks/${hook}"
  done

  # Shipped desktop config base for sweetpotatos-materialize.
  local dir
  for dir in swirl foot mako gtk-3.0 gtk-4.0 fastfetch swaylock xsettingsd \
             networkmanager-dmenu geany environment.d kanshi; do
    if [[ -d "${skel}/${dir}" ]]; then
      mkdir -p "${pkgdir}/usr/share/sweetpotato/config/${dir}"
      cp -a "${skel}/${dir}/." "${pkgdir}/usr/share/sweetpotato/config/${dir}/"
    fi
  done

  # System wallpapers — materialize copies these into ~/Pictures/Wallpapers.
  # Owned by this package (not airootfs) so pacstrap does not conflict.
  local walls="${ai}/etc/skel/Pictures/Wallpapers"
  if [[ -d "${walls}" ]]; then
    mkdir -p "${pkgdir}/usr/share/backgrounds/sweetpotatos"
    cp -f "${walls}/"*.png "${pkgdir}/usr/share/backgrounds/sweetpotatos/" 2>/dev/null || true
    rm -f "${pkgdir}/usr/share/backgrounds/sweetpotatos/UsefulBinds.png" \
          "${pkgdir}/usr/share/backgrounds/sweetpotatos/BindsBG.png"
  fi
}
