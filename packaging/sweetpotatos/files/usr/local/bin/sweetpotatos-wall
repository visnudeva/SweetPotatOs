#!/usr/bin/env bash
# Experimental Swirl wall-mode lab lane for SweetPotatOs.
# Pulls the wall-mode branch, builds Swirl over the packaged binary, and syncs
# SweetPotato wall toggle/keybinds into ~/.config/swirl.
#
# Usage:
#   sweetpotatos-wall              # pull + build/install + desktop bits
#   sweetpotatos-wall --check      # show checkout / binary status
#   sweetpotatos-wall --pull-only  # git pull only
#   sweetpotatos-wall --desktop-only  # config/scripts only (no rebuild)
#   sweetpotatos-wall --remove     # restore packaged Swirl + scrub desktop bits
#   sweetpotatos-update --wall     # same as sweetpotatos-wall
#   sweetpotatos-update --wall --remove  # same as sweetpotatos-wall --remove
set -euo pipefail

SWIRL_URL="${SWEETPOTATOS_SWIRL_URL:-https://github.com/visnudeva/swirl.git}"
SWIRL_BRANCH="${SWEETPOTATOS_WALL_BRANCH:-wall-mode-v1}"
POTATO_URL="${SWEETPOTATOS_SWEETPOTATO_URL:-https://github.com/visnudeva/SweetPotato.git}"
CODE_ROOT="${SWEETPOTATOS_WALL_ROOT:-${HOME}/code/GITHUB}"
SWIRL_DIR="${CODE_ROOT}/swirl"
POTATO_DIR="${CODE_ROOT}/SweetPotato"
BUILD_DIR="${SWIRL_DIR}/build-wall"

CHECK_ONLY=0
PULL_ONLY=0
DESKTOP_ONLY=0
REMOVE=0

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

for arg in "$@"; do
  case "$arg" in
    --check) CHECK_ONLY=1 ;;
    --pull-only) PULL_ONLY=1 ;;
    --desktop-only) DESKTOP_ONLY=1 ;;
    --remove|--uninstall) REMOVE=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$(id -u)" -eq 0 ]]; then
  echo "[!] Run as your desktop user (not root). Tip: sudo -u \"\$SUDO_USER\" -H sweetpotatos-wall" >&2
  exit 1
fi

info() { printf '[*] %s\n' "$*"; }
ok()   { printf '[+] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }

ensure_repo() {
  local url="$1" dir="$2" branch="${3:-}"
  if [[ -d "${dir}/.git" ]]; then
    info "git fetch ${dir}"
    git -C "$dir" fetch --prune origin
    if [[ -n "${branch}" ]]; then
      if git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
        git -C "$dir" checkout -B "$branch" "origin/${branch}"
      elif git -C "$dir" show-ref --verify --quiet "refs/heads/${branch}"; then
        git -C "$dir" checkout "$branch"
        git -C "$dir" pull --ff-only 2>/dev/null || true
      else
        warn "Branch ${branch} not on origin yet — keeping current checkout in ${dir}"
        warn "Push wall-mode-v1 from the machine that has the commits, then re-run."
      fi
    else
      git -C "$dir" pull --ff-only
    fi
  else
    info "git clone ${url} → ${dir}"
    mkdir -p "$(dirname "$dir")"
    if [[ -n "${branch}" ]]; then
      if ! git clone --branch "$branch" --single-branch "$url" "$dir"; then
        warn "Clone of ${branch} failed; cloning default branch"
        git clone "$url" "$dir"
        warn "Checkout ${branch} locally once it exists on origin."
      fi
    else
      git clone "$url" "$dir"
    fi
  fi
}

has_wall_cmd() {
  command -v swirlmsg >/dev/null 2>&1 || command -v swaymsg >/dev/null 2>&1 || return 1
  local msg
  msg="$(command -v swirlmsg 2>/dev/null || command -v swaymsg)"
  "${msg}" -t get_version >/dev/null 2>&1 || return 1
  # Probe for the command without changing state.
  local out
  out="$("${msg}" wall_mode 2>&1 || true)"
  [[ "${out}" != *"Unknown command"* && "${out}" != *"unknown command"* ]]
}

show_check() {
  echo "wall lab status"
  echo "  code root: ${CODE_ROOT}"
  echo "  branch:    ${SWIRL_BRANCH}"
  if [[ -d "${SWIRL_DIR}/.git" ]]; then
    echo "  swirl:     $(git -C "$SWIRL_DIR" rev-parse --abbrev-ref HEAD) @ $(git -C "$SWIRL_DIR" rev-parse --short HEAD) ($(git -C "$SWIRL_DIR" log -1 --format=%s))"
    if [[ -n "$(git -C "$SWIRL_DIR" status --porcelain)" ]]; then
      echo "             (dirty working tree)"
    fi
  else
    echo "  swirl:     not cloned"
  fi
  if [[ -d "${POTATO_DIR}/.git" ]]; then
    echo "  SweetPotato: $(git -C "$POTATO_DIR" rev-parse --short HEAD) ($(git -C "$POTATO_DIR" log -1 --format=%s))"
  else
    echo "  SweetPotato: not cloned"
  fi
  if [[ -x /usr/bin/swirl ]]; then
    echo "  /usr/bin/swirl: present ($(stat -c%s /usr/bin/swirl 2>/dev/null || echo ?) bytes)"
  else
    echo "  /usr/bin/swirl: missing"
  fi
  if [[ -x "${HOME}/.config/swirl/scripts/wall-mode.sh" ]]; then
    echo "  wall-mode.sh: ${HOME}/.config/swirl/scripts/wall-mode.sh"
  else
    echo "  wall-mode.sh: not installed in ~/.config/swirl/scripts"
  fi
  if has_wall_cmd; then
    echo "  IPC:       wall_mode available (running session)"
  else
    echo "  IPC:       wall_mode not available yet (rebuild + re-login)"
  fi
}

install_desktop_bits() {
  local dest="${HOME}/.config/swirl"
  local scripts="${dest}/scripts"
  mkdir -p "${scripts}"

  if [[ ! -d "${POTATO_DIR}/swirl" ]]; then
    warn "SweetPotato checkout missing; skipping desktop sync"
    return 0
  fi

  cp -f "${POTATO_DIR}/swirl/scripts/wall-mode.sh" "${scripts}/wall-mode.sh"
  chmod 755 "${scripts}/wall-mode.sh"
  mkdir -p "${HOME}/.config/sweetpotatos"
  printf 'on\n' >"${HOME}/.config/sweetpotatos/wall-lab"
  ok "Marked wall lab on (Settings → Wall appears)"
  if [[ -f "${POTATO_DIR}/swirl/scripts/settings.py" ]]; then
    cp -f "${POTATO_DIR}/swirl/scripts/settings.py" "${scripts}/settings.py"
    chmod 755 "${scripts}/settings.py"
  fi
  if [[ -f "${POTATO_DIR}/swirl/cheatsheet.txt" ]]; then
    cp -f "${POTATO_DIR}/swirl/cheatsheet.txt" "${dest}/cheatsheet.txt"
  fi
  inject_cheatsheet_wall

  local cfg="${dest}/config"
  if [[ -f "${cfg}" ]]; then
    if ! grep -q 'wall-mode\.sh toggle' "${cfg}"; then
      if grep -q 'hot-corner\.sh toggle' "${cfg}"; then
        sed -i '/hot-corner\.sh toggle/a\
    # Wall: focused tile first; Mod+Tab fits/zooms (Settings → Desktop → Wall).\
    bindsym $mod+Ctrl+Shift+w exec ~/.config/swirl/scripts/wall-mode.sh toggle\
    bindsym $mod+Alt+Left wall_pan left\
    bindsym $mod+Alt+Right wall_pan right\
    bindsym $mod+Alt+Up wall_pan up\
    bindsym $mod+Alt+Down wall_pan down\
    bindsym $mod+Alt+u wall_zoom out\
    bindsym $mod+Alt+n wall_zoom in\
    bindsym $mod+Alt+Return wall_zoom toggle' "${cfg}"
        ok "Injected wall keybinds into ~/.config/swirl/config"
      else
        warn "Could not find hot-corner bind to inject after; add wall binds by hand"
      fi
    elif ! grep -q 'wall_zoom' "${cfg}"; then
      # Older inject had pan only — add zoom binds after the last wall_pan line.
      if grep -q 'wall_pan down' "${cfg}"; then
        sed -i '/wall_pan down/a\
    bindsym $mod+Alt+u wall_zoom out\
    bindsym $mod+Alt+n wall_zoom in\
    bindsym $mod+Alt+Return wall_zoom toggle' "${cfg}"
        ok "Injected missing wall_zoom keybinds into ~/.config/swirl/config"
      fi
    fi
    if ! grep -q 'wall-mode\.sh apply' "${cfg}"; then
      if grep -q 'hot-corner\.sh apply' "${cfg}"; then
        sed -i '/hot-corner\.sh apply/a\
exec_always ~/.config/swirl/scripts/wall-mode.sh apply' "${cfg}"
        ok "Injected wall-mode apply into ~/.config/swirl/config"
      fi
    fi
  else
    warn "No ~/.config/swirl/config — copy SweetPotato swirl/config or run sprout"
  fi

  ok "Desktop wall bits synced"
}

build_and_install_swirl() {
  need() { command -v "$1" >/dev/null 2>&1 || { echo "missing: $1" >&2; exit 1; }; }
  need meson
  need ninja
  need sudo

  if [[ ! -f "${SWIRL_DIR}/meson.build" ]]; then
    echo "[!] ${SWIRL_DIR}/meson.build missing" >&2
    exit 1
  fi

  info "Meson setup ${BUILD_DIR} (prefix=/usr)"
  # Drop a half-configured tree (e.g. previous swirl.png failure) so setup can retry cleanly.
  if [[ -d "${BUILD_DIR}" && ! -f "${BUILD_DIR}/build.ninja" ]]; then
    warn "Removing incomplete ${BUILD_DIR}"
    rm -rf "${BUILD_DIR}"
  fi
  local meson_args=(
    --prefix=/usr
    -D sd-bus-provider=libsystemd
    -D werror=false
    -D b_ndebug=true
  )
  if [[ ! -f "${BUILD_DIR}/build.ninja" ]]; then
    meson setup "${BUILD_DIR}" "${SWIRL_DIR}" "${meson_args[@]}"
  else
    meson setup --reconfigure "${BUILD_DIR}" "${SWIRL_DIR}" "${meson_args[@]}"
  fi

  info "ninja -C ${BUILD_DIR}"
  ninja -C "${BUILD_DIR}"

  info "sudo ninja -C ${BUILD_DIR} install (overwrites packaged /usr/bin/swirl)"
  sudo ninja -C "${BUILD_DIR}" install
  ok "Installed wall-mode Swirl to /usr"
}

scrub_cheatsheet_wall() {
  local cheat="${HOME}/.config/swirl/cheatsheet.txt"
  [[ -f "${cheat}" ]] || return 0
  if grep -qE 'Wall mode|wall viewport|wall when wall|Mod\+Tab \(wall|wall_pan|Zoom wall' "${cheat}"; then
    info "Scrubbing wall lines from cheatsheet"
    sed -i \
      -e '/Wall mode (2D tile grid)/d' \
      -e '/Pan the wall viewport/d' \
      -e '/Zoom wall out/d' \
      -e '/Mod+Tab (wall on)/d' \
      -e '/Toggle fit-all/d' \
      -e 's/ (or pan the wall when wall mode is on)//' \
      "${cheat}"
    ok "Cheatsheet wall lines removed"
  fi
}

inject_cheatsheet_wall() {
  local cheat="${HOME}/.config/swirl/cheatsheet.txt"
  [[ -f "${cheat}" ]] || return 0
  if grep -q 'Wall mode (2D tile grid)' "${cheat}"; then
    return 0
  fi
  if grep -q 'Overview hot corner on/off' "${cheat}"; then
    info "Adding wall lines to cheatsheet"
    sed -i '/Overview hot corner on\/off/a\
  Mod+Ctrl+Shift+w   Wall mode (2D tile grid) on/off\
  Mod+Alt+arrows     Pan the wall viewport\
  Mod+Alt+u / n      Zoom wall out / in\
  Mod+Alt+Return     Toggle fit-all ↔ focused window\
  Mod+Tab (wall on)  Same fit/focus toggle (not workspace overview)' "${cheat}"
    sed -i 's/3-finger drag      Scroll strip$/3-finger drag      Scroll strip (or pan the wall when wall mode is on)/' "${cheat}" || true
    ok "Cheatsheet wall lines added"
  else
    warn "Could not find Overview hot corner line to inject wall binds after"
  fi
}

restore_settings_without_wall_toggle() {
  local settings="${HOME}/.config/swirl/scripts/settings.py"
  local src=""

  # Prefer the gated Settings from the SweetPotato checkout (shows Wall only
  # while wall-mode.sh exists). Fall back to shipping skel, then a local scrub.
  if [[ -f "${POTATO_DIR}/swirl/scripts/settings.py" ]]; then
    src="${POTATO_DIR}/swirl/scripts/settings.py"
  elif [[ -f /usr/share/sweetpotato/config/swirl/scripts/settings.py ]]; then
    src=/usr/share/sweetpotato/config/swirl/scripts/settings.py
  fi

  if [[ -n "${src}" && -f "${settings}" ]]; then
    info "Restoring Settings from ${src}"
    cp -f "${src}" "${settings}"
    chmod 755 "${settings}"
    ok "Settings restored (Wall row only appears if the lab is re-installed)"
    return 0
  fi

  if [[ -f "${settings}" ]] && grep -q 'Wall (2D grid + zoom)' "${settings}"; then
    info "Scrubbing unconditional Wall switch from Settings"
    # Drop the always-on switch row; keep the rest of Desktop intact.
    sed -i '/Wall (2D grid + zoom)/d' "${settings}"
    # Neutralize refresh/handler if the attribute is gone (best-effort).
    sed -i \
      -e 's/self\._set_switch(self\.sw_wall, wall_mode_on())/pass  # wall lab removed/' \
      "${settings}" || true
    ok "Wall switch line removed from Settings"
  fi
}

remove_desktop_bits() {
  local wall_sh="${HOME}/.config/swirl/scripts/wall-mode.sh"
  local cfg="${HOME}/.config/swirl/config"
  local state="${HOME}/.config/sweetpotatos/wall-mode"

  # Turn wall off in the live session before scrubbing (best-effort).
  if [[ -x "${wall_sh}" ]]; then
    info "Disabling wall mode"
    "${wall_sh}" off >/dev/null 2>&1 || true
  elif has_wall_cmd; then
    local msg
    msg="$(command -v swirlmsg 2>/dev/null || command -v swaymsg)"
    "${msg}" wall_mode disable >/dev/null 2>&1 || true
  fi

  if [[ -f "${cfg}" ]]; then
    if grep -qE 'wall-mode\.sh|wall_pan|wall_zoom|wall_mode' "${cfg}"; then
      info "Scrubbing wall binds from ~/.config/swirl/config"
      # Drop wall comment, binds, and exec_always apply lines.
      sed -i \
        -e '/# Wall: focused tile first/d' \
        -e '/wall-mode\.sh toggle/d' \
        -e '/wall-mode\.sh apply/d' \
        -e '/[[:space:]]wall_pan /d' \
        -e '/[[:space:]]wall_zoom /d' \
        "${cfg}"
      ok "Removed wall lines from swirl config"
    else
      info "No wall lines in ~/.config/swirl/config"
    fi
  fi

  if [[ -e "${wall_sh}" ]]; then
    rm -f "${wall_sh}"
    ok "Removed ${wall_sh}"
  fi
  if [[ -e "${state}" ]]; then
    rm -f "${state}"
    ok "Removed wall-mode state file"
  fi
  if [[ -e "${HOME}/.config/sweetpotatos/wall-lab" ]]; then
    rm -f "${HOME}/.config/sweetpotatos/wall-lab"
    ok "Cleared wall-lab marker (Settings → Wall hidden)"
  fi

  restore_settings_without_wall_toggle
  scrub_cheatsheet_wall
}

restore_packaged_swirl() {
  need() { command -v "$1" >/dev/null 2>&1 || { echo "missing: $1" >&2; exit 1; }; }
  need sudo
  need pacman

  info "Reinstalling packaged swirl from the SweetPotatOs channel"
  # Force even if --needed would skip: the wall meson install left a foreign binary.
  if ! sudo pacman -S --noconfirm sweetpotatos/swirl 2>/dev/null; then
    sudo pacman -S --noconfirm swirl
  fi
  ok "Packaged /usr/bin/swirl restored"

  if [[ -d "${BUILD_DIR}" ]]; then
    info "Removing wall build tree ${BUILD_DIR}"
    rm -rf "${BUILD_DIR}"
    ok "Removed build-wall"
  fi
}

remove_wall_lab() {
  remove_desktop_bits
  restore_packaged_swirl
  ok "wall lab removed — back to packaged Swirl"
  echo "    Log out and back into Swirl so the packaged compositor loads."
  echo "    Status:  sweetpotatos-wall --check   (IPC should say wall_mode not available)"
  show_check
}

main() {
  if [[ "$CHECK_ONLY" -eq 1 ]]; then
    show_check
    exit 0
  fi

  if [[ "$REMOVE" -eq 1 ]]; then
    remove_wall_lab
    exit 0
  fi

  need() { command -v "$1" >/dev/null 2>&1 || { echo "missing: $1" >&2; exit 1; }; }
  need git

  ensure_repo "$SWIRL_URL" "$SWIRL_DIR" "$SWIRL_BRANCH"
  ensure_repo "$POTATO_URL" "$POTATO_DIR" ""

  if [[ "$PULL_ONLY" -eq 1 ]]; then
    ok "Pulled swirl (${SWIRL_BRANCH}) + SweetPotato"
    show_check
    exit 0
  fi

  install_desktop_bits

  if [[ "$DESKTOP_ONLY" -eq 1 ]]; then
    ok "Desktop-only wall sync done"
    echo "    Rebuild compositor:  sweetpotatos-update --wall"
    echo "    Status:              sweetpotatos-wall --check"
    show_check
    exit 0
  fi

  build_and_install_swirl

  ok "wall lab install done"
  echo "    Log out and back into Swirl to load the new binary."
  echo "    Toggle: Settings → Desktop → Wall, or Mod+Ctrl+Shift+w"
  echo "    Update again:  sweetpotatos-update --wall"
  echo "    Remove:        sweetpotatos-wall --remove"
  echo "    Status:        sweetpotatos-wall --check"
  echo "    Note: a later pacman swirl upgrade may overwrite this binary — re-run --wall."
  show_check
}

main
