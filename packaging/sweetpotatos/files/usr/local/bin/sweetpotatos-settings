#!/usr/bin/env bash
# Open SweetPotatOs Settings (Mod+,).
# Deep-link a page: sweetpotatos-settings open look|desktop|system|apps|help
script="${HOME}/.config/swirl/scripts/settings.py"
if [[ ! -f "${script}" ]]; then
  script=/usr/share/sweetpotato/config/swirl/scripts/settings.py
fi
exec python3 "${script}" "$@"
