#!/bin/sh
# SweetPotato: drop Archcraft gtk-nocsd so GTK apps keep close buttons
unset LD_PRELOAD
export GTK_CSD=1
if [ -n "${HOME:-}" ] && [ -x "${HOME}/.config/swirl/scripts/ensure-display-state.sh" ]; then
  /usr/bin/env bash "${HOME}/.config/swirl/scripts/ensure-display-state.sh" 2>/dev/null || true
fi
dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# Ly's session_log only captures stdout; stderr stays on the login VT and
# flashes compositor/tray teardown when the session ends. Keep both in the log.
log="${HOME:-/tmp}/.local/state/ly-session.log"
mkdir -p "$(dirname "$log")" 2>/dev/null || true
for bin in /usr/bin/swirl \
           "${HOME}/.local/libexec/swirl" \
           "${dir}/../libexec/swirl"; do
  if [ -x "$bin" ] && [ ! "$bin" -ef "$0" ]; then
    exec "$bin" "$@" >>"$log" 2>&1
  fi
done
echo "swirl not found — install the swirl package or build from https://github.com/visnudeva/swirl" >&2
exit 127
