# Remove stock Sway session after the sway package lands.
# Ly does not honor Hidden=/NoDisplay= on .desktop files.
# (Do not ship sway.desktop in airootfs — conflicts during pacstrap.)

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = sway

[Action]
Description = Removing stock Sway session (SweetPotatOs uses Swirl)...
When = PostTransaction
Depends = sh
Depends = coreutils
Exec = /bin/sh -c 'rm -f /usr/share/wayland-sessions/sway.desktop; mkdir -p /etc/ly/wayland-sessions; if [ -f /usr/share/wayland-sessions/swirl.desktop ]; then install -Dm644 /usr/share/wayland-sessions/swirl.desktop /etc/ly/wayland-sessions/swirl.desktop; fi'
