# Set SweetPotatOs Plymouth theme BEFORE 90-mkinitcpio-install.hook
# so the live initramfs includes the theme (not stock bgrt/spinner).
# (plymouthd.conf is owned by the package, so airootfs would be overwritten.)

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = plymouth

[Action]
Description = Applying SweetPotatOs Plymouth theme...
When = PostTransaction
Depends = sh
Exec = /usr/local/bin/sweetpotatos-plymouth
