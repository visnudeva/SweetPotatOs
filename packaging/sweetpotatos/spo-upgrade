#!/usr/bin/bash
# Upgrade an installed SweetPotatOs system without reinstalling the ISO.
set -euo pipefail

BRAND=/usr/local/share/sweetpotatos/os-release
REPO_CONF=/etc/pacman.d/sweetpotatos.conf
REPO_CONF_DISABLED="${REPO_CONF}.spo-upgrade-off"
MIGRATION_STATE=/var/lib/sweetpotatos/migrations
SWEETPOTATO_REPO="${SWEETPOTATO_REPO:-https://github.com/visnudeva/SweetPotato.git}"
SWEETPOTATO_REF="${SWEETPOTATO_REF:-main}"
SPO_REPO_BASE="${SPO_REPO_BASE:-https://downloads.sourceforge.net/project/sweetpotatos/repo/x86_64}"

SPO_REPO_PKGS=(sweetpotatos swirl yay-bin shelly-bin localsend-bin spore waypaper)

DO_THEME=0
DO_CHECK=0
DO_DRY_RUN=0

info() { echo "[spo-upgrade] $*"; }
warn() { echo "[spo-upgrade] WARNING: $*" >&2; }
die() { echo "[spo-upgrade] ERROR: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: spo-upgrade [options]

Upgrade SweetPotatOs in place (Arch packages + SweetPotatOs overlay repo).

Options:
  --check       Show installed vs available sweetpotatos version; exit
  --dry-run     Show planned steps without changing the system
  --theme       Also refresh the SweetPotato desktop theme (git clone + install.sh)
  -h, --help    Show this help

Requires root (sudo spo-upgrade).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --theme) DO_THEME=1 ;;
    --check) DO_CHECK=1 ;;
    --dry-run) DO_DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

[[ "${EUID}" -eq 0 ]] || die "run as root: sudo spo-upgrade"

[[ -f "${BRAND}" ]] && grep -q '^ID=sweetpotatos' "${BRAND}" \
  || die "this does not look like SweetPotatOs (${BRAND} missing or wrong ID)"

installed_version() {
  if [[ -f "${BRAND}" ]]; then
    grep -E '^VERSION(_ID)?=' "${BRAND}" 2>/dev/null || true
  fi
  pacman -Q sweetpotatos 2>/dev/null || echo "sweetpotatos package: not installed"
}

fix_pacman_conf() {
  local conf=/etc/pacman.conf
  [[ -f "${conf}" ]] || return 0
  if grep -q '^\[sweetpotatos\]' "${conf}"; then
    info "Removing stale [sweetpotatos] file:// entry from ${conf}"
    awk '
      /^\[sweetpotatos\]/ { skip=1; next }
      /^\[/ && skip { skip=0 }
      !skip { print }
    ' "${conf}" > "${conf}.spo-upgrade.tmp"
    mv "${conf}.spo-upgrade.tmp" "${conf}"
  fi
  if ! grep -qF 'Include = /etc/pacman.d/sweetpotatos.conf' "${conf}"; then
    info "Enabling SweetPotatOs pacman repo include in ${conf}"
    printf '\nInclude = /etc/pacman.d/sweetpotatos.conf\n' >> "${conf}"
  fi
}

fix_repo_urls() {
  local f=$1
  [[ -f "${f}" ]] || return 0
  if grep -q 'sf-mirror.net' "${f}"; then
    info "Removing dead sf-mirror.net entry from ${f}"
    sed -i '/sf-mirror.net/d' "${f}"
  fi
  if grep -q '/repo/\$arch' "${f}"; then
    info "Fixing stale repo/\$arch URL in ${f}"
    sed -i 's|/repo/\$arch|/repo/x86_64|g' "${f}"
  elif grep -qE 'project/sweetpotatos/repo[[:space:]]*$' "${f}"; then
    info "Fixing flat repo URL in ${f}"
    sed -i 's|project/sweetpotatos/repo$|project/sweetpotatos/repo/x86_64|g' "${f}"
  fi
  if grep -q 'Optional TrustAll' "${f}"; then
    info "Fixing SigLevel in ${f} (unsigned repo)"
    sed -i 's|^SigLevel = Optional TrustAll|SigLevel = Never|' "${f}"
  fi
}

disable_xfer_command() {
  local conf=/etc/pacman.conf
  [[ -f "${conf}" ]] || return 0
  if grep -q '^XferCommand = ' "${conf}"; then
    info "Removing XferCommand from ${conf} (breaks official repo signature checks)"
    sed -i '/^XferCommand = /d' "${conf}"
  fi
}

ensure_repo_conf() {
  if [[ ! -f "${REPO_CONF}" ]]; then
    info "Installing ${REPO_CONF}"
    if [[ -f /usr/share/sweetpotatos/pacman/sweetpotatos.conf ]]; then
      install -Dm644 /usr/share/sweetpotatos/pacman/sweetpotatos.conf "${REPO_CONF}"
    else
      install -Dm644 /dev/stdin "${REPO_CONF}" <<'EOF'
[sweetpotatos]
SigLevel = Never
Server = https://downloads.sourceforge.net/project/sweetpotatos/repo/x86_64
EOF
    fi
  else
    fix_repo_urls "${REPO_CONF}"
  fi
  fix_repo_urls /usr/share/sweetpotatos/pacman/sweetpotatos.conf
  fix_pacman_conf
  disable_xfer_command
}

clear_bad_sync_dbs() {
  local f
  shopt -s nullglob
  for f in /var/lib/pacman/sync/*.db; do
    if ! file "${f}" | grep -q 'gzip compressed data'; then
      warn "Removing corrupt sync db ${f} ($(file -b "${f}"))"
      rm -f "${f}" "${f}.sig" "${f}.part"
    fi
  done
  rm -f /var/lib/pacman/sync/sweetpotatos.db*
  shopt -u nullglob
}

disable_overlay_repo() {
  [[ -f "${REPO_CONF}" ]] && mv "${REPO_CONF}" "${REPO_CONF_DISABLED}"
}

enable_overlay_repo() {
  [[ -f "${REPO_CONF_DISABLED}" ]] && mv "${REPO_CONF_DISABLED}" "${REPO_CONF}"
}

overlay_db_version() {
  local db=$1 pkg=$2
  tar -xOzf "${db}" --wildcards "${pkg}-*/desc" 2>/dev/null \
    | awk '/^%VERSION%/{getline; print; exit}'
}

fetch_overlay_db() {
  local dest=$1
  curl -Lf -o "${dest}" "${SPO_REPO_BASE}/sweetpotatos.db" \
    || die "could not download ${SPO_REPO_BASE}/sweetpotatos.db"
  if ! file "${dest}" | grep -q 'gzip compressed data'; then
    die "overlay repo db is not valid gzip (got $(file -b "${dest}"))"
  fi
}

upgrade_overlay_via_curl() {
  command -v curl >/dev/null || die "curl is required"
  local work db pkg fn path
  local -a to_install=()
  work="$(mktemp -d /tmp/spo-repo.XXXXXX)"
  db="${work}/sweetpotatos.db"
  trap 'rm -rf "${work}"' RETURN

  info "Fetching overlay package index from SourceForge…"
  fetch_overlay_db "${db}"

  for pkg in "${SPO_REPO_PKGS[@]}"; do
    fn="$(tar -xOzf "${db}" --wildcards "${pkg}-*/desc" 2>/dev/null \
      | awk '/^%FILENAME%/{getline; print; exit}')"
    if [[ -z "${fn}" ]]; then
      warn "package ${pkg} not listed in overlay repo"
      continue
    fi
    if [[ -f "/var/cache/pacman/pkg/${fn}" ]] \
      && file "/var/cache/pacman/pkg/${fn}" | grep -q 'Zstandard\|gzip compressed\|POSIX tar'; then
      path="/var/cache/pacman/pkg/${fn}"
      info "Using cached ${fn}"
    else
      path="${work}/${fn}"
      info "Downloading ${fn}…"
      curl -Lf -o "${path}" "${SPO_REPO_BASE}/${fn}" \
        || { warn "failed to download ${fn}"; continue; }
    fi
    to_install+=("${path}")
  done

  if ((${#to_install[@]} == 0)); then
    warn "no overlay packages downloaded"
    return 1
  fi

  info "Installing overlay packages…"
  pacman -U --needed --noconfirm --overwrite '*' "${to_install[@]}"
}

run_migrations() {
  local dir=/usr/share/sweetpotatos/migrations
  [[ -d "${dir}" ]] || return 0
  mkdir -p "${MIGRATION_STATE}"
  local script base stamp
  shopt -s nullglob
  for script in "${dir}"/*.sh; do
    base="$(basename "${script}")"
    stamp="${MIGRATION_STATE}/${base}.done"
    [[ -f "${stamp}" ]] && continue
    info "Migration: ${base}"
    if (( DO_DRY_RUN )); then
      info "(dry-run) would run ${script}"
      continue
    fi
    bash "${script}"
    touch "${stamp}"
  done
  shopt -u nullglob
}

upgrade_theme() {
  local work
  work="$(mktemp -d /tmp/sweetpotato-upgrade.XXXXXX)"
  trap 'rm -rf "${work}"' RETURN
  info "Fetching SweetPotato theme (${SWEETPOTATO_REF})…"
  if (( DO_DRY_RUN )); then
    info "(dry-run) would clone ${SWEETPOTATO_REPO} and run install.sh as ${SPO_USER:-root}"
    return 0
  fi
  local theme_user="${SPO_USER:-${SUDO_USER:-}}"
  [[ -n "${theme_user}" && "${theme_user}" != "root" ]] || die "--theme needs a login user (set SPO_USER=yourname)"
  git clone --depth 1 --branch "${SWEETPOTATO_REF}" "${SWEETPOTATO_REPO}" "${work}/SweetPotato"
  info "Running SweetPotato install.sh as ${theme_user}…"
  sudo -u "${theme_user}" bash -c "cd '${work}/SweetPotato' && ./install.sh"
}

ensure_repo_conf
clear_bad_sync_dbs

if (( DO_DRY_RUN )); then
  info "Dry run — no packages will change"
fi

info "Installed: $(installed_version | tr '\n' ' '; echo)"

if (( DO_CHECK )); then
  work="$(mktemp -d /tmp/spo-check.XXXXXX)"
  fetch_overlay_db "${work}/sweetpotatos.db"
  if ver="$(overlay_db_version "${work}/sweetpotatos.db" sweetpotatos)"; then
    info "Overlay repo sweetpotatos version: ${ver}"
    if pacman -Q sweetpotatos &>/dev/null; then
      installed="$(pacman -Q sweetpotatos | awk '{print $2}')"
      [[ "${installed}" == "${ver}" ]] \
        && info "sweetpotatos package is up to date" \
        || info "Upgrade available (${installed} → ${ver})"
    else
      info "sweetpotatos package is not installed yet"
    fi
  fi
  rm -rf "${work}"
  exit 0
fi

if (( DO_DRY_RUN )); then
  info "Would sync official repos (overlay repo disabled during sync)"
  info "Would run: pacman -Su"
  info "Would install overlay packages via curl from ${SPO_REPO_BASE}"
  run_migrations
  (( DO_THEME )) && upgrade_theme
  exit 0
fi

kernel_before="$(pacman -Q linux 2>/dev/null | awk '{print $2}' || true)"

info "Syncing official Arch repositories…"
disable_overlay_repo
if ! pacman -Sy; then
  warn "pacman -Sy failed — clearing all sync dbs and retrying once"
  rm -f /var/lib/pacman/sync/*.db /var/lib/pacman/sync/*.db.sig
  pacman -Sy
fi
enable_overlay_repo

info "Upgrading system packages…"
pacman -Su --noconfirm

info "Upgrading SweetPotatOs overlay packages…"
upgrade_overlay_via_curl || warn "some overlay packages could not be installed"

run_migrations

if (( DO_THEME )); then
  upgrade_theme
fi

/usr/local/bin/sweetpotatos-branding 2>/dev/null || true

kernel_after="$(pacman -Q linux 2>/dev/null | awk '{print $2}' || true)"
if [[ -n "${kernel_before}" && -n "${kernel_after}" && "${kernel_before}" != "${kernel_after}" ]]; then
  info "Linux kernel updated (${kernel_before} → ${kernel_after}); rebuilding initramfs…"
  mkinitcpio -P
  warn "Reboot recommended to load the new kernel."
fi

info "Done. $(installed_version | tr '\n' ' '; echo)"
