#!/usr/bin/env bash
# Upgrade SweetPotatOs-owned packages from [sweetpotatos], install any that are
# new on the channel, then refresh shipped config.
# Does not run a full pacman -Syu (kernel / Arch base stay on the Arch lane).
set -euo pipefail

REPO_NAME=sweetpotatos
# Desktop lane packages. If present on [sweetpotatos], install (when missing) or upgrade.
CANDIDATES=(
  sweetpotatos
  swirl
  spore
  tuber
  swaylock-effects
  shelly-bin
  localsend-bin
  brave-origin-bin
  waypaper
  yay-bin
  python-screeninfo
  python-imageio-ffmpeg
)

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi

echo "[*] Syncing package databases…"
pacman -Sy --noconfirm

to_touch=()
for pkg in "${CANDIDATES[@]}"; do
  if pacman -Si "${REPO_NAME}/${pkg}" >/dev/null 2>&1; then
    to_touch+=("${REPO_NAME}/${pkg}")
  fi
done

if ((${#to_touch[@]} == 0)); then
  echo "[!] No SweetPotatOs packages available from [${REPO_NAME}]; check the repo is enabled."
  exit 0
fi

# Replace conflicting Arch packages — --noconfirm will not auto-remove them.
for t in "${to_touch[@]}"; do
  if [[ "${t}" == "${REPO_NAME}/tuber" ]]; then
    remove=()
    for old in transmission-gtk transmission-cli transmission-qt transmission; do
      if pacman -Q "${old}" >/dev/null 2>&1; then
        remove+=("${old}")
      fi
    done
    if ((${#remove[@]} > 0)); then
      echo "[*] Removing Transmission (replaced by tuber): ${remove[*]}"
      pacman -Rdd --noconfirm "${remove[@]}" || true
    fi
  fi
  if [[ "${t}" == "${REPO_NAME}/swaylock-effects" ]]; then
    if pacman -Q swaylock >/dev/null 2>&1 && ! pacman -Q swaylock-effects >/dev/null 2>&1; then
      echo "[*] Removing swaylock (replaced by swaylock-effects)"
      pacman -Rdd --noconfirm swaylock || true
    fi
  fi
done

echo "[*] Installing/upgrading: ${to_touch[*]}"
pacman -S --needed --noconfirm "${to_touch[@]}"

if command -v sweetpotatos-materialize >/dev/null 2>&1; then
  # Materialize as the real desktop user (never root's HOME).
  target_user="${SUDO_USER:-}"
  if [[ -z "${target_user}" || "${target_user}" == root ]]; then
    target_user="$(logname 2>/dev/null || true)"
  fi
  if [[ -n "${target_user}" && "${target_user}" != root ]]; then
    target_home="$(getent passwd "${target_user}" | cut -d: -f6 || true)"
    if [[ -z "${target_home}" || ! -d "${target_home}" ]]; then
      target_home="$(eval echo "~${target_user}")"
    fi
    target_uid="$(id -u "${target_user}" 2>/dev/null || true)"
    echo "[*] Materializing desktop config for ${target_user} (${target_home})…"
    sudo -u "${target_user}" HOME="${target_home}" \
      XDG_CONFIG_HOME="${target_home}/.config" \
      XDG_STATE_HOME="${target_home}/.local/state" \
      sweetpotatos-materialize || true

    # Guaranteed refresh of the help sheet script (no overlay / stale copy).
    src_cheat="/usr/share/sweetpotato/config/swirl/scripts/cheatsheet.sh"
    dst_cheat="${target_home}/.config/swirl/scripts/cheatsheet.sh"
    if [[ -f "${src_cheat}" ]]; then
      install -Dm755 "${src_cheat}" "${dst_cheat}"
      chown "${target_user}:${target_user}" "${dst_cheat}" 2>/dev/null || true
    fi

    # Reload Swirl so shipped config changes apply — users should not need Mod+Shift+c.
    if [[ -n "${target_uid}" ]]; then
      shopt -s nullglob
      socks=(/run/user/"${target_uid}"/sway-ipc.*.sock)
      shopt -u nullglob
      if ((${#socks[@]} > 0)) && command -v swaymsg >/dev/null 2>&1; then
        echo "[*] Reloading Swirl session…"
        sudo -u "${target_user}" SWAYSOCK="${socks[0]}" swaymsg reload >/dev/null 2>&1 || true
      fi
    fi
  else
    echo "[!] Skipping materialize — no non-root user to target (ran as root?)." >&2
  fi
fi

waiting="$(pacman -Qu 2>/dev/null | wc -l | tr -d ' ')"
echo "[+] SweetPotatOs update done. Open Mod+? for the help sheet — nothing else to run."
if [[ "${waiting}" != 0 ]]; then
  echo "    (Optional later: Arch/system packages waiting: ${waiting} — pacman -Syu)"
fi
