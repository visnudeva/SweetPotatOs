#!/usr/bin/env bash
# Upgrade SweetPotatOs-owned packages from [sweetpotatos], then refresh shipped config.
# Does not run a full pacman -Syu (kernel / Arch base stay on the Arch lane).
set -euo pipefail

REPO_NAME=sweetpotatos
# Packages we may move on this channel (only those already installed are touched).
CANDIDATES=(
  sweetpotatos
  swirl
  spore
  tuber
  shelly-bin
  localsend-bin
  brave-origin-bin
  waypaper
  yay-bin
  python-screeninfo
  python-imageio-ffmpeg
)

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi

echo "[*] Syncing package databases…"
pacman -Sy --noconfirm

to_upgrade=()
for pkg in "${CANDIDATES[@]}"; do
  if pacman -Q "${pkg}" >/dev/null 2>&1; then
    to_upgrade+=("${REPO_NAME}/${pkg}")
  fi
done

if ((${#to_upgrade[@]} == 0)); then
  echo "[!] No SweetPotatOs packages installed; nothing to upgrade."
  exit 0
fi

echo "[*] Upgrading: ${to_upgrade[*]}"
pacman -S --needed --noconfirm "${to_upgrade[@]}"

if command -v sweetpotatos-materialize >/dev/null 2>&1; then
  # Materialize as the invoking user when possible.
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != root ]]; then
    echo "[*] Materializing desktop config for ${SUDO_USER}…"
    sudo -u "${SUDO_USER}" -H sweetpotatos-materialize || true
  else
    echo "[*] Materializing desktop config…"
    sweetpotatos-materialize || true
  fi
fi

waiting="$(pacman -Qu 2>/dev/null | wc -l | tr -d ' ')"
echo "[+] SweetPotatOs lane done. Arch/system packages waiting: ${waiting} (use: pacman -Syu)"
