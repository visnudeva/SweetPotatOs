#!/usr/bin/env bash
# Upgrade SweetPotatOs-owned packages from [sweetpotatos], install any that are
# new on the channel, then refresh shipped config.
# Does not run a full pacman -Syu (kernel / Arch base stay on the Arch lane).
set -euo pipefail

REPO_NAME=sweetpotatos
# Same repo name on both channels; the Server URL is the branch.
# Live stays the default. --testing persists until --stable.
CONF="${SWEETPOTATOS_UPDATE_CONF:-/etc/pacman.d/sweetpotatos.conf}"
CHANNEL_FILE="${SWEETPOTATOS_UPDATE_CHANNEL_FILE:-/var/lib/sweetpotatos/update-channel}"
LIVE_SERVER=https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo
TESTING_SERVER=https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo-testing
# Desktop lane packages. If present on [sweetpotatos], install (when missing) or upgrade.
CANDIDATES=(
  sweetpotatos
  swirl
  spore
  tuber
  swaylock-effects
  shelly-bin
  localsend-bin
  brave-origin-bin
  waypaper
  yay-bin
  python-screeninfo
  python-imageio-ffmpeg
)

usage() {
  cat <<EOF
Usage: sweetpotatos-update [--testing|--stable|--check]
  (no flag)   update from the channel this machine is already tracking
  --testing   track pacman-repo-testing until --stable
  --stable    track the live pacman-repo release
  --check     print SweetPotatOs packages that would install or upgrade
EOF
}

requested=""
check_only=0
case "${1:-}" in
  "") ;;
  --testing) requested=testing ;;
  --stable) requested=stable ;;
  --check) check_only=1 ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: ${1}" >&2
    usage >&2
    exit 2
    ;;
esac
if [[ -n "${2:-}" ]]; then
  echo "Unexpected extra argument: ${2}" >&2
  usage >&2
  exit 2
fi

if [[ "${EUID}" -ne 0 && "${SWEETPOTATOS_UPDATE_APPLY_ONLY:-}" != 1 ]]; then
  exec sudo -- "$0" "$@"
fi

infer_channel() {
  if [[ -f "${CHANNEL_FILE}" ]]; then
    local saved
    saved="$(tr -d '[:space:]' <"${CHANNEL_FILE}" || true)"
    case "${saved}" in
      testing|stable) printf '%s\n' "${saved}"; return ;;
    esac
  fi
  if [[ -f "${CONF}" ]] && grep -qE '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo-testing[[:space:]]*$' "${CONF}"; then
    printf '%s\n' testing
    return
  fi
  printf '%s\n' stable
}

apply_channel() {
  local channel="$1" url
  case "${channel}" in
    testing) url="${TESTING_SERVER}" ;;
    stable) url="${LIVE_SERVER}" ;;
    *)
      echo "[!] Unknown channel: ${channel}" >&2
      exit 1
      ;;
  esac
  if [[ ! -f "${CONF}" ]]; then
    echo "[!] ${CONF} is missing; cannot select a channel." >&2
    exit 1
  fi
  if ! grep -qE '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo(-testing)?[[:space:]]*$' "${CONF}"; then
    echo "[!] ${CONF} is not the GitHub package channel; refusing to switch it." >&2
    exit 1
  fi
  sed -i -E "s|^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo(-testing)?[[:space:]]*$|Server = ${url}|" "${CONF}"
  install -d "$(dirname "${CHANNEL_FILE}")"
  printf '%s\n' "${channel}" >"${CHANNEL_FILE}"
  echo "[*] Update channel: ${channel}"
  echo "    Server = ${url}"
}

channel="${requested:-$(infer_channel)}"
if [[ "${check_only}" == 1 ]]; then
  apply_channel "${channel}" >/dev/null
else
  apply_channel "${channel}"
fi
# APPLY_ONLY stops before installing. --check still queries pacman so tests
# can supply a fake pacman without becoming root.
if [[ "${SWEETPOTATOS_UPDATE_APPLY_ONLY:-}" == 1 && "${check_only}" != 1 ]]; then
  exit 0
fi

if [[ "${check_only}" == 1 ]]; then
  pacman -Sy --noconfirm >/dev/null
  to_touch=()
  for pkg in "${CANDIDATES[@]}"; do
    if pacman -Si "${REPO_NAME}/${pkg}" >/dev/null 2>&1; then
      to_touch+=("${REPO_NAME}/${pkg}")
    fi
  done
  if ((${#to_touch[@]} == 0)); then
    exit 0
  fi
  pacman -S --print --print-format '%n' --needed --noconfirm "${to_touch[@]}" 2>/dev/null || true
  exit 0
fi

echo "[*] Syncing package databases…"
pacman -Sy --noconfirm

to_touch=()
for pkg in "${CANDIDATES[@]}"; do
  if pacman -Si "${REPO_NAME}/${pkg}" >/dev/null 2>&1; then
    to_touch+=("${REPO_NAME}/${pkg}")
  fi
done

if ((${#to_touch[@]} == 0)); then
  echo "[!] No SweetPotatOs packages available from [${REPO_NAME}]; check the repo is enabled."
  exit 0
fi

# Replace conflicting Arch packages — --noconfirm will not auto-remove them.
for t in "${to_touch[@]}"; do
  if [[ "${t}" == "${REPO_NAME}/tuber" ]]; then
    remove=()
    for old in transmission-gtk transmission-cli transmission-qt transmission; do
      if pacman -Q "${old}" >/dev/null 2>&1; then
        remove+=("${old}")
      fi
    done
    if ((${#remove[@]} > 0)); then
      echo "[*] Removing Transmission (replaced by tuber): ${remove[*]}"
      pacman -Rdd --noconfirm "${remove[@]}" || true
    fi
  fi
  if [[ "${t}" == "${REPO_NAME}/swaylock-effects" ]]; then
    if pacman -Q swaylock >/dev/null 2>&1 && ! pacman -Q swaylock-effects >/dev/null 2>&1; then
      echo "[*] Removing swaylock (replaced by swaylock-effects)"
      pacman -Rdd --noconfirm swaylock || true
    fi
  fi
done

changed="$(pacman -S --print --print-format '%n' --needed --noconfirm "${to_touch[@]}" 2>/dev/null || true)"
changed="$(printf '%s\n' "${changed}" | sed '/^$/d')"
# Captured before the transaction so the note can list every change since this version.
previous_sweetpotatos="$(pacman -Q sweetpotatos 2>/dev/null | awk '{print $2}' || true)"

echo "[*] Installing/upgrading: ${to_touch[*]}"
pacman -S --needed --noconfirm "${to_touch[@]}"

reloaded=0
if command -v sweetpotatos-materialize >/dev/null 2>&1; then
  # Materialize as the real desktop user (never root's HOME).
  target_user="${SUDO_USER:-}"
  if [[ -z "${target_user}" || "${target_user}" == root ]]; then
    target_user="$(logname 2>/dev/null || true)"
  fi
  if [[ -n "${target_user}" && "${target_user}" != root ]]; then
    target_home="$(getent passwd "${target_user}" | cut -d: -f6 || true)"
    if [[ -z "${target_home}" || ! -d "${target_home}" ]]; then
      target_home="$(eval echo "~${target_user}")"
    fi
    target_uid="$(id -u "${target_user}" 2>/dev/null || true)"
    echo "[*] Materializing desktop config for ${target_user} (${target_home})…"
    sudo -u "${target_user}" HOME="${target_home}" \
      XDG_CONFIG_HOME="${target_home}/.config" \
      XDG_STATE_HOME="${target_home}/.local/state" \
      sweetpotatos-materialize || true

    # Guaranteed refresh of the help sheet script (no overlay / stale copy).
    src_cheat="/usr/share/sweetpotato/config/swirl/scripts/cheatsheet.sh"
    dst_cheat="${target_home}/.config/swirl/scripts/cheatsheet.sh"
    if [[ -f "${src_cheat}" ]]; then
      install -Dm755 "${src_cheat}" "${dst_cheat}"
      chown "${target_user}:${target_user}" "${dst_cheat}" 2>/dev/null || true
    fi

    # Materialize writes the default Sweet potato colors. Put the saved
    # choice back before Swirl reloads, so the desktop does not snap back.
    theme_script="${target_home}/.config/swirl/scripts/theme.sh"
    if [[ -f "${theme_script}" ]]; then
      echo "[*] Restoring the selected theme…"
      sudo -u "${target_user}" HOME="${target_home}" \
        XDG_CONFIG_HOME="${target_home}/.config" \
        "${theme_script}" --quiet apply || true
    fi

    # The old save-layout shortcut wrote "1920x1080@60" with no Hz, and
    # "position 0,0". Swirl rejects that on reload. Add Hz and split the
    # position so the saved arrangement stays. A Displays Apply file already
    # ends in Hz and is left alone.
    outputs_file="${target_home}/.config/sway/outputs"
    if [[ -s "${outputs_file}" ]] && grep -E -q \
      '(^|[[:space:]])mode[[:space:]]+(--[[:alnum:]-]+[[:space:]]+)?[0-9]+x[0-9]+@[0-9]+(\.[0-9]+)?([[:space:]]|$)' \
      "${outputs_file}"; then
      echo "[*] Correcting the saved display layout so Swirl can read the refresh rate…"
      sed -E -i \
        -e 's/@([0-9]+(\.[0-9]+)?)([[:space:]]|$)/@\1Hz\3/g' \
        -e 's/position[[:space:]]+([-0-9]+),([-0-9]+)/position \1 \2/g' \
        "${outputs_file}"
      chown "${target_user}:${target_user}" "${outputs_file}" 2>/dev/null || true
      sync_kanshi="${target_home}/.config/swirl/scripts/sync-kanshi-from-outputs.sh"
      if [[ -x "${sync_kanshi}" ]]; then
        sudo -u "${target_user}" HOME="${target_home}" \
          XDG_CONFIG_HOME="${target_home}/.config" \
          "${sync_kanshi}" || true
      fi
    fi

    # Reload Swirl so shipped config changes apply — users should not need Mod+Shift+c.
    if [[ -n "${target_uid}" ]]; then
      shopt -s nullglob
      socks=(/run/user/"${target_uid}"/sway-ipc.*.sock /run/user/"${target_uid}"/swirl-ipc.*.sock)
      shopt -u nullglob
      if ((${#socks[@]} > 0)) && command -v swaymsg >/dev/null 2>&1; then
        echo "[*] Reloading Swirl session…"
        if sudo -u "${target_user}" SWAYSOCK="${socks[0]}" swaymsg reload >/dev/null 2>&1; then
          reloaded=1
        fi
        # Reload starts the normal idle timeouts. If caffeine was on, put
        # the timeout-free watcher back and drop any old idle inhibitor.
        caffeine_state="/run/user/${target_uid}/sweetpotato-caffeine.state"
        caffeine_script="${target_home}/.config/swirl/scripts/caffeine.sh"
        if [[ -f "${caffeine_state}" && "$(cat "${caffeine_state}")" == on && -f "${caffeine_script}" ]]; then
          echo "[*] Caffeine was on — restoring it without an idle lock…"
          sudo -u "${target_user}" HOME="${target_home}" \
            XDG_RUNTIME_DIR="/run/user/${target_uid}" \
            "${caffeine_script}" on || true
        fi
      fi
    fi
  else
    echo "[!] Skipping materialize — no non-root user to target (ran as root?)." >&2
  fi
fi

if command -v sweetpotatos-update-notify >/dev/null 2>&1; then
  # Reload restarts mako; give it a moment before the what-changed note.
  if [[ "${reloaded}" == 1 && "${SWEETPOTATOS_NOTIFY_NO_SLEEP:-}" != 1 ]]; then
    sleep 2
  fi
  # The notify script on disk is the one just installed. Pass the version
  # from before the transaction so it can show every note in between.
  printf '%s\n' "${changed}" | SWEETPOTATOS_UPDATE_FROM="${previous_sweetpotatos}" \
    sweetpotatos-update-notify applied || true
fi

waiting="$(pacman -Qu 2>/dev/null | wc -l | tr -d ' ')"
echo "[+] SweetPotatOs update done. Open Mod+? for the help sheet — nothing else to run."
if [[ "${waiting}" != 0 ]]; then
  echo "    (Optional later: Arch/system packages waiting: ${waiting} — pacman -Syu)"
fi
