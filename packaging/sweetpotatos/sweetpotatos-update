#!/usr/bin/env bash
# Upgrade SweetPotatOs-owned packages from [sweetpotatos], install any that are
# new on the channel, then refresh shipped config.
# Does not run a full pacman -Syu (kernel / Arch base stay on the Arch lane).
set -euo pipefail

REPO_NAME=sweetpotatos
# Same repo name on both channels; the Server URL is the branch.
# Live stays the default. --testing persists until --stable.
CONF="${SWEETPOTATOS_UPDATE_CONF:-/etc/pacman.d/sweetpotatos.conf}"
CHANNEL_FILE="${SWEETPOTATOS_UPDATE_CHANNEL_FILE:-/var/lib/sweetpotatos/update-channel}"
LIVE_SERVER=https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo
TESTING_SERVER=https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo-testing
# Desktop lane packages. If present on [sweetpotatos], install (when missing) or upgrade.
CANDIDATES=(
  sweetpotatos
  swirl
  spore
  tuber
  laniakea
  swaylock-effects
  shelly-bin
  localsend-bin
  brave-origin-bin
  waypaper
  yay-bin
  python-screeninfo
  python-imageio-ffmpeg
)

usage() {
  cat <<EOF
Usage: sweetpotatos-update [--testing|--stable|--check|--renewm|--wall [--remove]]
  (no flag)   update from the channel this machine is already tracking
  --testing   track pacman-repo-testing until --stable
  --stable    track the live pacman-repo release
  --check     print SweetPotatOs packages that would install or upgrade
  --renewm    experimental renewm lab only (does NOT touch Swirl / desktop packages)
  --wall      experimental Swirl wall-mode lab (builds wall branch over packaged swirl)
  --wall --remove  restore packaged Swirl and scrub wall desktop bits
EOF
}

# Isolated lab lanes: never mixed into CANDIDATES / normal desktop updates.
run_lab_helper() {
  local flag="$1"
  local name="$2"
  shift 2
  local helper="/usr/local/bin/${name}"
  if [[ ! -x "${helper}" ]]; then
    # Dev checkout fallback (maintainer machine / before the package ships).
    local self_dir
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "${self_dir}/files/usr/local/bin/${name}" ]]; then
      helper="${self_dir}/files/usr/local/bin/${name}"
    elif [[ -x "${self_dir}/../files/usr/local/bin/${name}" ]]; then
      helper="${self_dir}/../files/usr/local/bin/${name}"
    else
      echo "[!] ${name} is not installed yet." >&2
      echo "    Rebuild/install the sweetpotatos package, or run the helper from the SweetPotatOs tree." >&2
      exit 1
    fi
  fi
  if [[ "${EUID}" -eq 0 ]]; then
    local target_user="${SUDO_USER:-}"
    if [[ -z "${target_user}" || "${target_user}" == root ]]; then
      echo "[!] ${flag} must run as the desktop user (got root)." >&2
      exit 1
    fi
    exec sudo -u "${target_user}" -H "${helper}" "$@"
  fi
  exec "${helper}" "$@"
}

if [[ "${1:-}" == "--renewm" ]]; then
  shift
  run_lab_helper --renewm sweetpotatos-renewm "$@"
fi

if [[ "${1:-}" == "--wall" ]]; then
  shift
  run_lab_helper --wall sweetpotatos-wall "$@"
fi

requested=""
check_only=0
case "${1:-}" in
  "") ;;
  --testing) requested=testing ;;
  --stable) requested=stable ;;
  --check) check_only=1 ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: ${1}" >&2
    usage >&2
    exit 2
    ;;
esac
if [[ -n "${2:-}" ]]; then
  echo "Unexpected extra argument: ${2}" >&2
  usage >&2
  exit 2
fi

if [[ "${EUID}" -ne 0 && "${SWEETPOTATOS_UPDATE_APPLY_ONLY:-}" != 1 ]]; then
  exec sudo -- "$0" "$@"
fi

infer_channel() {
  if [[ -f "${CHANNEL_FILE}" ]]; then
    local saved
    saved="$(tr -d '[:space:]' <"${CHANNEL_FILE}" || true)"
    case "${saved}" in
      testing|stable) printf '%s\n' "${saved}"; return ;;
    esac
  fi
  if [[ -f "${CONF}" ]] && grep -qE '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo-testing[[:space:]]*$' "${CONF}"; then
    printf '%s\n' testing
    return
  fi
  printf '%s\n' stable
}

apply_channel() {
  local channel="$1" url
  case "${channel}" in
    testing) url="${TESTING_SERVER}" ;;
    stable) url="${LIVE_SERVER}" ;;
    *)
      echo "[!] Unknown channel: ${channel}" >&2
      exit 1
      ;;
  esac
  if [[ ! -f "${CONF}" ]]; then
    echo "[!] ${CONF} is missing; cannot select a channel." >&2
    exit 1
  fi
  if ! grep -qE '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo(-testing)?[[:space:]]*$' "${CONF}"; then
    echo "[!] ${CONF} is not the GitHub package channel; refusing to switch it." >&2
    exit 1
  fi
  sed -i -E "s|^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://github.com/visnudeva/SweetPotatOs/releases/download/pacman-repo(-testing)?[[:space:]]*$|Server = ${url}|" "${CONF}"
  install -d "$(dirname "${CHANNEL_FILE}")"
  printf '%s\n' "${channel}" >"${CHANNEL_FILE}"
  echo "[*] Update channel: ${channel}"
  echo "    Server = ${url}"
}

channel="${requested:-$(infer_channel)}"
if [[ "${check_only}" == 1 ]]; then
  apply_channel "${channel}" >/dev/null
else
  apply_channel "${channel}"
fi
# APPLY_ONLY stops before installing. --check still queries pacman so tests
# can supply a fake pacman without becoming root.
if [[ "${SWEETPOTATOS_UPDATE_APPLY_ONLY:-}" == 1 && "${check_only}" != 1 ]]; then
  exit 0
fi

if [[ "${check_only}" == 1 ]]; then
  pacman -Sy --noconfirm >/dev/null
  to_touch=()
  for pkg in "${CANDIDATES[@]}"; do
    if pacman -Si "${REPO_NAME}/${pkg}" >/dev/null 2>&1; then
      to_touch+=("${REPO_NAME}/${pkg}")
    fi
  done
  if ((${#to_touch[@]} == 0)); then
    exit 0
  fi
  pacman -S --print --print-format '%n' --needed --noconfirm "${to_touch[@]}" 2>/dev/null || true
  exit 0
fi

echo "[*] Syncing package databases…"
pacman -Sy --noconfirm

to_touch=()
for pkg in "${CANDIDATES[@]}"; do
  if pacman -Si "${REPO_NAME}/${pkg}" >/dev/null 2>&1; then
    to_touch+=("${REPO_NAME}/${pkg}")
  fi
done

if ((${#to_touch[@]} == 0)); then
  echo "[!] No SweetPotatOs packages available from [${REPO_NAME}]; check the repo is enabled."
  exit 0
fi

# Replace conflicting Arch packages — --noconfirm will not auto-remove them.
for t in "${to_touch[@]}"; do
  if [[ "${t}" == "${REPO_NAME}/tuber" ]]; then
    remove=()
    for old in transmission-gtk transmission-cli transmission-qt transmission; do
      if pacman -Q "${old}" >/dev/null 2>&1; then
        remove+=("${old}")
      fi
    done
    if ((${#remove[@]} > 0)); then
      echo "[*] Removing Transmission (replaced by tuber): ${remove[*]}"
      pacman -Rdd --noconfirm "${remove[@]}" || true
    fi
  fi
  if [[ "${t}" == "${REPO_NAME}/swaylock-effects" ]]; then
    if pacman -Q swaylock >/dev/null 2>&1 && ! pacman -Q swaylock-effects >/dev/null 2>&1; then
      echo "[*] Removing swaylock (replaced by swaylock-effects)"
      pacman -Rdd --noconfirm swaylock || true
    fi
  fi
  if [[ "${t}" == "${REPO_NAME}/swirl" ]]; then
    # pacman -S will not drop a conflicting package. Swirl owns the bar,
    # swaymsg, and swaynag names, so the Arch sway package has to go first.
    if pacman -Q sway >/dev/null 2>&1; then
      echo "[*] Removing sway (replaced by swirl)"
      pacman -Rdd --noconfirm sway
    fi
  fi
done

changed="$(pacman -S --print --print-format '%n' --needed --noconfirm "${to_touch[@]}" 2>/dev/null || true)"
changed="$(printf '%s\n' "${changed}" | sed '/^$/d')"
# Captured before the transaction so the note can list every change since this version.
previous_sweetpotatos="$(pacman -Q sweetpotatos 2>/dev/null | awk '{print $2}' || true)"

# Lab helpers (renewm / wall) may exist as unowned files from an earlier
# sweetpotatos-update --renewm/--wall before they shipped in the package.
# Pacman then aborts with "exists in filesystem" and upgrades nothing.
_clear_unowned_spo_bins() {
  local path owner
  for path in \
    /usr/local/bin/sweetpotatos-renewm \
    /usr/local/bin/sweetpotatos-renew \
    /usr/local/bin/sweetpotatos-wall
  do
    [[ -e "${path}" || -L "${path}" ]] || continue
    owner="$(pacman -Qo "${path}" 2>/dev/null || true)"
    if [[ -z "${owner}" ]]; then
      echo "[*] Removing unowned ${path} so the sweetpotatos package can own it"
      rm -f "${path}"
    fi
  done
}
_clear_unowned_spo_bins

# Only install packages that actually need an upgrade — avoids a wall of
# "up to date -- skipping" warnings for every channel candidate.
to_install=()
while IFS= read -r name; do
  [[ -n "${name}" ]] || continue
  to_install+=("${REPO_NAME}/${name}")
done < <(printf '%s\n' "${changed}")

if ((${#to_install[@]} > 0)); then
  echo "[*] Installing/upgrading: ${to_install[*]}"
  pacman -S --needed --noconfirm "${to_install[@]}"
else
  echo "[*] Channel packages already current."
fi

# Refresh sweetpotatos (+ swirl) so shipped scripts/configs always land.
# Prefer the local pacman cache — a second CDN download often 404s right
# after a testing upload even though the package is already installed.
_spo_reinstall_pkg() {
  local pkg="$1"
  local overwrite='/usr/local/bin/sweetpotatos-renew*,/usr/local/bin/sweetpotatos-wall'
  local ver cached
  ver="$(pacman -Q "${pkg}" 2>/dev/null | awk '{print $2}')" || return 0
  cached="$(
    ls -1t /var/cache/pacman/pkg/"${pkg}-${ver}"-*.pkg.tar.zst 2>/dev/null | head -1 || true
  )"
  if [[ -n "${cached}" && -f "${cached}" ]]; then
    echo "[*] Reinstalling ${pkg} ${ver} from local cache…"
    pacman -U --noconfirm --overwrite "${overwrite}" "${cached}" && return 0
  fi
  echo "[*] Reinstalling ${pkg} from the channel…"
  if pacman -S --noconfirm --overwrite "${overwrite}" "${REPO_NAME}/${pkg}" 2>/dev/null \
    || pacman -S --noconfirm --overwrite "${overwrite}" "${pkg}" 2>/dev/null; then
    return 0
  fi
  echo "[!] Could not reinstall ${pkg}; continuing with the installed package."
  return 0
}

echo "[*] Refreshing sweetpotatos + swirl…"
_clear_unowned_spo_bins
_spo_reinstall_pkg sweetpotatos
_spo_reinstall_pkg swirl

# Always scrub configs for every /home user (not gated on sprout/SUDO_USER).
if [[ -x /usr/local/bin/sweetpotatos-fix-swirl-config ]]; then
  echo "[*] Fixing swirl configs (no parse-time bar border_*; scrub tint)…"
  /usr/local/bin/sweetpotatos-fix-swirl-config || true
fi

if command -v sweetpotatos-sprout >/dev/null 2>&1; then
  # Sprout as the real desktop user (never root's HOME).
  target_user="${SUDO_USER:-}"
  if [[ -z "${target_user}" || "${target_user}" == root ]]; then
    target_user="$(logname 2>/dev/null || true)"
  fi
  if [[ -n "${target_user}" && "${target_user}" != root ]]; then
    target_home="$(getent passwd "${target_user}" | cut -d: -f6 || true)"
    if [[ -z "${target_home}" || ! -d "${target_home}" ]]; then
      target_home="$(eval echo "~${target_user}")"
    fi

    echo "[*] Sprouting desktop config for ${target_user} (${target_home})…"
    sudo -u "${target_user}" HOME="${target_home}" \
      XDG_CONFIG_HOME="${target_home}/.config" \
      XDG_STATE_HOME="${target_home}/.local/state" \
      sweetpotatos-sprout || true

    # Guaranteed refresh of desktop UI scripts (ignore user_edits / stale copies).
    # cheatsheet.sh alone is not enough — it execs cheatsheet.py + spo_ui.py;
    # status.sh / settings.py are what make the thin bar + panel look visible.
    shipped_scripts=(
      cheatsheet.sh
      cheatsheet.py
      spo_ui.py
      status.sh
      tray-mode.sh
      settings.py
      system_panel.py
      hue.py
      theme.sh
      tips.sh
    )
    for script_name in "${shipped_scripts[@]}"; do
      src_script="/usr/share/sweetpotato/config/swirl/scripts/${script_name}"
      dst_script="${target_home}/.config/swirl/scripts/${script_name}"
      if [[ -f "${src_script}" ]]; then
        install -Dm755 "${src_script}" "${dst_script}"
        chown "${target_user}:${target_user}" "${dst_script}" 2>/dev/null || true
      fi
      # Drop overlay forks so the next sprout does not put the old file back.
      rm -f "${target_home}/.config/sweetpotatos/user_edits/swirl/scripts/${script_name}"
    done
    # Light tray — drop GTK applets; remove retired detailed-status leftovers.
    tray_script="${target_home}/.config/swirl/scripts/tray-mode.sh"
    if [[ -x "${tray_script}" ]]; then
      sudo -u "${target_user}" HOME="${target_home}" \
        XDG_CONFIG_HOME="${target_home}/.config" \
        "${tray_script}" apply >/dev/null 2>&1 || true
    fi
    rm -f "${target_home}/.config/swirl/scripts/status-detail.sh" \
      "${target_home}/.config/sweetpotatos/status-detail" \
      "${target_home}/.config/sweetpotatos/user_edits/swirl/scripts/status-detail.sh"
    # Keybinds text + bar chrome comments live beside the scripts.
    for rel in swirl/cheatsheet.txt swirl/config; do
      src_cfg="/usr/share/sweetpotato/config/${rel}"
      dst_cfg="${target_home}/.config/${rel}"
      if [[ -f "${src_cfg}" ]]; then
        install -Dm644 "${src_cfg}" "${dst_cfg}"
        chown "${target_user}:${target_user}" "${dst_cfg}" 2>/dev/null || true
      fi
    done
    # Wall is opt-in lab. Drop leaked toggle/script unless wall-lab marker is set.
    if [[ ! -f "${target_home}/.config/sweetpotatos/wall-lab" ]]; then
      rm -f "${target_home}/.config/swirl/scripts/wall-mode.sh" \
            "${target_home}/.config/sweetpotatos/wall-mode" \
            "${target_home}/.config/sweetpotatos/user_edits/swirl/scripts/wall-mode.sh"
    fi

    # Sprout writes the default Sweet potato colors. Put the saved choice
    # back so the next login does not snap to the skel theme.
    theme_script="${target_home}/.config/swirl/scripts/theme.sh"
    if [[ -f "${theme_script}" ]]; then
      echo "[*] Restoring the selected theme…"
      sudo -u "${target_user}" HOME="${target_home}" \
        XDG_CONFIG_HOME="${target_home}/.config" \
        "${theme_script}" --quiet apply || true
    fi

    xorg_kbd=/etc/X11/xorg.conf.d/00-keyboard.conf
    live_swirl_cfg="${target_home}/.config/swirl/config"
    if [[ -f "${xorg_kbd}" && -f "${live_swirl_cfg}" ]]; then
      layout="$(sed -n 's/.*Option[[:space:]]*"XkbLayout"[[:space:]]*"\([^"]*\)".*/\1/p' "${xorg_kbd}" | head -1)"
      variant="$(sed -n 's/.*Option[[:space:]]*"XkbVariant"[[:space:]]*"\([^"]*\)".*/\1/p' "${xorg_kbd}" | head -1)"
      if [[ -n "${layout}" ]]; then
        sed -i "s|^[[:space:]]*xkb_layout[[:space:]]\".*\"|    xkb_layout \"${layout}\"|" "${live_swirl_cfg}" || true
        if [[ -n "${variant}" ]]; then
          if grep -q '^[[:space:]]*xkb_variant' "${live_swirl_cfg}"; then
            sed -i "s|^[[:space:]]*xkb_variant[[:space:]].*|    xkb_variant \"${variant}\"|" "${live_swirl_cfg}" || true
          else
            sed -i "/xkb_layout /a\\    xkb_variant \"${variant}\"" "${live_swirl_cfg}" || true
          fi
        fi
        chown "${target_user}:${target_user}" "${live_swirl_cfg}" 2>/dev/null || true
      fi
    fi

    # The old save-layout shortcut wrote "1920x1080@60" with no Hz, and
    # "position 0,0". Swirl rejects that. Add Hz and split the position so
    # the saved arrangement stays. A Displays Apply file already ends in Hz.
    outputs_file="${target_home}/.config/sway/outputs"
    if [[ -s "${outputs_file}" ]] && grep -E -q \
      '(^|[[:space:]])mode[[:space:]]+(--[[:alnum:]-]+[[:space:]]+)?[0-9]+x[0-9]+@[0-9]+(\.[0-9]+)?([[:space:]]|$)' \
      "${outputs_file}"; then
      echo "[*] Correcting the saved display layout so Swirl can read the refresh rate…"
      sed -E -i \
        -e 's/@([0-9]+(\.[0-9]+)?)([[:space:]]|$)/@\1Hz\3/g' \
        -e 's/position[[:space:]]+([-0-9]+),([-0-9]+)/position \1 \2/g' \
        "${outputs_file}"
      chown "${target_user}:${target_user}" "${outputs_file}" 2>/dev/null || true
      sync_kanshi="${target_home}/.config/swirl/scripts/sync-kanshi-from-outputs.sh"
      if [[ -x "${sync_kanshi}" ]]; then
        sudo -u "${target_user}" HOME="${target_home}" \
          XDG_CONFIG_HOME="${target_home}/.config" \
          "${sync_kanshi}" || true
      fi
    fi

    # Never reload into the running compositor after a swirl reinstall —
    # that painted Invalid command when binary and config disagreed.
    echo "[!] Log out and back in (or reboot) so the installed Swirl binary starts."
    echo "    Do not Mod+Shift+c — reload cannot replace the running compositor."
  else
    echo "[!] Skipping sprout — no non-root user to target (ran as root?)." >&2
  fi
fi

# Scrub only — do not reinstall the US skel again (that wiped FR keyboard /
# theme after sprout restored them).
if [[ -x /usr/local/bin/sweetpotatos-fix-swirl-config ]]; then
  echo "[*] Final scrub of swirl configs (keep keyboard + theme)…"
  SWEETPOTATOS_SCRUB_ONLY=1 /usr/local/bin/sweetpotatos-fix-swirl-config || true
fi
echo "[!] Log out once (or reboot) so Swirl picks up packages and config."

# Drop a retired testing helper if present.
if pacman -Q spo-gtk-live >/dev/null 2>&1; then
  echo "[*] Removing the GTK color-reload helper…"
  pacman -Rns --noconfirm spo-gtk-live || pacman -Rdd --noconfirm spo-gtk-live || true
fi

if command -v sweetpotatos-update-notify >/dev/null 2>&1; then
  # The notify script on disk is the one just installed. Pass the version
  # from before the transaction so it can show every note in between.
  printf '%s\n' "${changed}" | SWEETPOTATOS_UPDATE_FROM="${previous_sweetpotatos}" \
    sweetpotatos-update-notify applied || true
fi

waiting="$(pacman -Qu 2>/dev/null | wc -l | tr -d ' ')"
echo "[+] SweetPotatOs update done. Open Mod+? for the help sheet — nothing else to run."
if [[ "${waiting}" != 0 ]]; then
  echo "    Arch/system packages waiting: ${waiting}"
  # Prompt on a real terminal (sudo still has /dev/tty). Non-interactive runs skip.
  if [[ -r /dev/tty ]]; then
    printf '    Do you want to update the Arch/system packages as well? [y/N] ' >/dev/tty
    reply=""
    IFS= read -r reply </dev/tty || true
    case "${reply}" in
      y|Y|yes|Yes|YES)
        echo "[*] Running pacman -Syu…"
        pacman -Syu
        ;;
      *)
        echo "    Skipped. Optional later: pacman -Syu"
        ;;
    esac
  else
    echo "    (Optional later: pacman -Syu)"
  fi
fi
