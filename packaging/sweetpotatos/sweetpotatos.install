post_install() {
  post_upgrade "$@"
}

_ensure_pacman_include() {
  local conf=/etc/pacman.conf
  local drop=/etc/pacman.d/sweetpotatos.conf
  [[ -f "${drop}" ]] || return 0
  [[ -f "${conf}" ]] || return 0
  if grep -qE '^[[:space:]]*Include[[:space:]]*=[[:space:]]*/etc/pacman\.d/sweetpotatos\.conf' "${conf}"; then
    return 0
  fi
  printf '\n# SweetPotatOs package channel (GitHub Releases; ISOs stay on SourceForge)\nInclude = /etc/pacman.d/sweetpotatos.conf\n' >>"${conf}"
}

# ISO images already have these files, unowned by any package. Copying after
# the transaction avoids "exists in filesystem".
_install_logos() {
  local src=/usr/share/sweetpotatos/branding
  [[ -d "${src}" ]] || return 0
  install -Dm644 "${src}/hicolor-256.png" \
    /usr/share/icons/hicolor/256x256/apps/sweetpotatos.png
  install -Dm644 "${src}/pixmap.png" \
    /usr/share/pixmaps/sweetpotatos.png
  install -Dm644 "${src}/pixmap-icon.png" \
    /usr/share/pixmaps/sweetpotatos-icon.png
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -qf /usr/share/icons/hicolor >/dev/null 2>&1 || true
  fi
}

# Boot shows the logo packed into the initramfs. Shutdown reads the theme
# from disk, so a logo update showed up there first.
_refresh_boot_splash() {
  if [[ -x /usr/local/bin/sweetpotatos-plymouth ]]; then
    /usr/local/bin/sweetpotatos-plymouth || true
  fi
  # Live ISO build and the live session keep the archiso preset.
  [[ -f /etc/mkinitcpio.conf.d/archiso.conf ]] && return 0
  compgen -G '/etc/mkinitcpio.d/*.preset' >/dev/null || return 0
  command -v mkinitcpio >/dev/null 2>&1 || return 0
  mkinitcpio -P
}

# Undo the 186–188 boot-quiet experiment: deadlock drop-in, extra cmdline
# tokens (duplicate splash), and os-prober flooding the GRUB menu with UEFI entries.
_revert_boot_quiet_experiment() {
  [[ -f /etc/mkinitcpio.conf.d/archiso.conf ]] && return 0
  rm -f /usr/local/bin/sweetpotatos-boot-quiet
  if [[ -e /usr/lib/systemd/system/plymouth-quit.service.d/10-sweetpotatos-retain-splash.conf ]]; then
    rm -f /usr/lib/systemd/system/plymouth-quit.service.d/10-sweetpotatos-retain-splash.conf
    rmdir /usr/lib/systemd/system/plymouth-quit.service.d 2>/dev/null || true
    systemctl daemon-reload || true
  fi
  local grub=/etc/default/grub
  [[ -f "${grub}" ]] || return 0
  local changed=0
  if grep -qE '^[[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT=' "${grub}"; then
    local line val new
    line="$(grep -E '^[[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT=' "${grub}")"
    val="${line#*GRUB_CMDLINE_LINUX_DEFAULT=}"
    val="${val#\"}"; val="${val%\"}"
    val="${val#\'}"; val="${val%\'}"
    new="$(echo "${val}" | awk '{
      out=""; seen_splash=0
      for (i=1;i<=NF;i++) {
        t=$i
        if (t=="loglevel=3" || t=="systemd.show_status=false" ||
            t=="rd.systemd.show_status=false" || t=="rd.udev.log_level=3") continue
        if (t=="splash") { if (seen_splash) continue; seen_splash=1 }
        out=(out==""?t:out" "t)
      }
      print out
    }')"
    if [[ "${new}" != "${val}" ]]; then
      local tmp; tmp="$(mktemp)"
      awk -v n="${new}" '
        BEGIN { done=0 }
        /^[[:space:]]*GRUB_CMDLINE_LINUX_DEFAULT=/ && !done {
          print "GRUB_CMDLINE_LINUX_DEFAULT=\"" n "\""
          done=1; next
        }
        { print }
      ' "${grub}" >"${tmp}"
      mv -f "${tmp}" "${grub}"
      changed=1
    fi
  fi
  # Arch often has GRUB_DISABLE_OS_PROBER=false; that is what flooded the menu.
  # Force it off for sole-OS SweetPotatOs (set false again only if you dual-boot).
  if grep -qE '^[[:space:]]*GRUB_DISABLE_OS_PROBER=' "${grub}"; then
    if ! grep -qE '^[[:space:]]*GRUB_DISABLE_OS_PROBER=true' "${grub}"; then
      sed -i 's/^[[:space:]]*GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=true/' "${grub}"
      changed=1
    fi
  else
    printf '\n# SweetPotatOs: sole-OS menu (set false only if you dual-boot).\nGRUB_DISABLE_OS_PROBER=true\n' >>"${grub}"
    changed=1
  fi
  # Always rewrite grub.cfg on this path so leftover os-prober UEFI entries go away.
  if command -v grub-mkconfig >/dev/null 2>&1; then
    if [[ -d /boot/grub ]]; then
      grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
    elif [[ -d /boot/grub/x86_64-efi ]] || [[ -e /boot/EFI ]]; then
      grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
    fi
  fi
}

# The updater copies these only when it can see a desktop user. Do it here too,
# inside the package transaction, so an update still refreshes the picker.
_sync_wallpapers() {
  local src=/usr/share/sweetpotato/backgrounds
  local uid gid home dest base
  [[ -d "${src}" ]] || return 0
  while IFS=: read -r _ _ uid gid _ home _; do
    [[ "${uid}" =~ ^[0-9]+$ ]] || continue
    [[ "${uid}" -ge 1000 ]] || continue
    [[ "${home}" == /home/* && -d "${home}" ]] || continue
    for dest in "${home}/Pictures/Wallpapers" "${home}/.local/share/backgrounds"; do
      mkdir -p "${dest}"
      rm -f "${dest}/SPONeonKanji2.png"
      for base in "${src}"/*.png; do
        [[ -f "${base}" ]] || continue
        cp -f "${base}" "${dest}/"
        chown "${uid}:${gid}" "${dest}/$(basename "${base}")" 2>/dev/null || true
      done
      chown "${uid}:${gid}" "${dest}" 2>/dev/null || true
    done
  done < /etc/passwd
}

post_upgrade() {
  _ensure_pacman_include
  _sync_wallpapers
  _install_logos
  if command -v sweetpotatos-branding >/dev/null 2>&1; then
    sweetpotatos-branding || true
  fi
  systemctl daemon-reload || true
  systemctl enable sweetpotatos-update-check.timer >/dev/null 2>&1 || true
  # $2 is the previous version. A fresh install has none; Calamares builds
  # the initramfs after the packages are unpacked.
  if [[ -n "${2:-}" ]]; then
    _revert_boot_quiet_experiment
    _refresh_boot_splash
  fi
}

pre_remove() {
  systemctl disable --now sweetpotatos-update-check.timer >/dev/null 2>&1 || true
}
