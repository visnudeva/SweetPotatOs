# Maintainer: visnudeva
pkgname=laniakea
pkgver=0.1.6
pkgrel=1
pkgdesc='Generative flow-field wallpaper for Swirl (opt-in)'
arch=('any')
url='https://github.com/visnudeva/swirl-laniakea'
license=('GPL-3.0-or-later')
depends=(
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
  'webkitgtk-6.0'
  'swaybg'
)
optdepends=(
  'waypaper: remember the applied wallpaper across logins'
)
makedepends=('git')
source=("git+https://github.com/visnudeva/swirl-laniakea.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd swirl-laniakea
  local n
  n="$(git rev-list --count HEAD)"
  printf '0.1.5.r%s.g%s' "${n}" "$(git rev-parse --short=7 HEAD)"
}

build() {
  :
}

package() {
  local src="${srcdir}/swirl-laniakea"
  # Local override while iterating before a push lands.
  if [[ -n "${LANIAKEA_SRC:-}" && -d "${LANIAKEA_SRC}/laniakea" ]]; then
    src="${LANIAKEA_SRC}"
  fi

  install -d "${pkgdir}/usr/lib/laniakea"
  cp -a "${src}/laniakea" "${pkgdir}/usr/lib/laniakea/"
  find "${pkgdir}/usr/lib/laniakea" -type d -name '__pycache__' -exec rm -rf {} +
  find "${pkgdir}/usr/lib/laniakea" -type f -name '*.pyc' -delete
  install -d "${pkgdir}/usr/share/laniakea"
  cp -a "${src}/share/laniakea/web" "${pkgdir}/usr/share/laniakea/"

  install -Dm644 "${src}/data/laniakea.desktop" \
    "${pkgdir}/usr/share/applications/laniakea.desktop"
  install -Dm644 "${src}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${src}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  cat <<'EOF' | install -Dm755 /dev/stdin "${pkgdir}/usr/bin/laniakea"
#!/usr/bin/env bash
export PYTHONPATH="/usr/lib/laniakea${PYTHONPATH:+:$PYTHONPATH}"
export LANIAKEA_WEB_ROOT="${LANIAKEA_WEB_ROOT:-/usr/share/laniakea/web}"
exec python3 -m laniakea "$@"
EOF
}
