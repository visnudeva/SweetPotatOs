# Local PKGBUILD wrapper: AUR tera needs go for `make` but omits makedepends.
# Maintainer notes live in SweetPotatOs NOTES.md (Packages / AUR).
pkgname=tera
pkgver=3.11.0
pkgrel=1
pkgdesc="Interactive terminal internet radio player (Radio Browser)"
arch=('x86_64')
url="https://github.com/shinokada/tera"
license=('MIT')
depends=('bash' 'mpv' 'jq' 'fzf' 'github-cli' 'wget' 'python')
makedepends=('go')
source=("https://github.com/shinokada/tera/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('8dfa0bf0e4a4d4c823ab5941e26f0bedc1b2e8079cfb7f6c479cff2c8303ef07')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  # Upstream Makefile runs tests; skip network-heavy tests at package time.
  if [[ -f go.mod ]]; then
    go build -o tera .
  fi
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  if [[ -x tera ]]; then
    install -Dm755 tera "${pkgdir}/usr/bin/tera"
  elif [[ -f tera ]]; then
    install -Dm755 tera "${pkgdir}/usr/bin/tera"
  else
    make DESTDIR="${pkgdir}" PREFIX=/usr install || install -Dm755 tera "${pkgdir}/usr/bin/tera"
  fi
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}
