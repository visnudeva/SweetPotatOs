# Local PKGBUILD: AUR localsend-bin plus explicit Ayatana tray deps.
# Arch libayatana-appindicator 0.6.0-2 omits libayatana-indicator / ayatana-ido
# from depends; LocalSend's tray plugin needs them at runtime.
# Upstream: https://github.com/localsend/localsend
pkgname=localsend-bin
pkgver=1.18.0
pkgrel=4
pkgdesc='An open source cross-platform alternative to AirDrop'
url=https://github.com/localsend/localsend
arch=('x86_64' 'aarch64')
license=(Apache-2.0)
depends=(
  fuse2
  xdg-user-dirs
  libayatana-appindicator
  libayatana-indicator
  ayatana-ido
)
conflicts=('localsend')
provides=('localsend')
options=(!debug)
source_x86_64=("${url}/releases/download/v${pkgver}/LocalSend-${pkgver}-linux-x86-64.deb")
source_aarch64=("${url}/releases/download/v${pkgver}/LocalSend-${pkgver}-linux-arm-64.deb")
sha256sums_x86_64=('dae68192ad43a59a68df06454eb5fa4e9a9f86a343fe430165efd8b18863d0f4')
sha256sums_aarch64=('eb24e724fbdf830c8fb07dfc66b76b8a649923d083278305a63d5d539db4b606')
_pkgdesktop="localsend_app.desktop"

prepare() {
  tar -xf data.tar.zst
}

build() {
  sed -i -E \
    "s|Exec=localsend_app|Exec=localsend|" \
    "${srcdir}/usr/share/applications/${_pkgdesktop}"

  sed -i -E 's/^Icon=.+/Icon=localsend/' "${srcdir}/usr/share/applications/${_pkgdesktop}"

  gcc -shared -fPIC -O2 -o tray-icon.so "${startdir}/tray-icon.c" -ldl
}

package() {
  install -Dm644 "${srcdir}/usr/share/applications/${_pkgdesktop}" \
    "${pkgdir}/usr/share/applications/${pkgname%-*}.desktop"

  install -dm644 "${pkgdir}/usr/share/icons/"
  cp -a "${srcdir}/usr/share/icons" "${pkgdir}/usr/share"
  for res in "128x128" "256x256"; do
    mv "${pkgdir}/usr/share/icons/hicolor/${res}/apps/localsend_app.png" \
      "${pkgdir}/usr/share/icons/hicolor/${res}/apps/localsend.png"
  done

  install -dm755 "${pkgdir}/opt/${pkgname%-*}/"
  cp -a "${srcdir}/opt/localsend_app/." "${pkgdir}/opt/${pkgname%-*}"
  mv "${pkgdir}/opt/${pkgname%-*}/localsend_app" "${pkgdir}/opt/${pkgname%-*}/localsend"

  install -dm755 "${pkgdir}/usr/bin"
  install -Dm755 "${startdir}/localsend" "${pkgdir}/usr/bin/${pkgname%-*}"
  install -Dm755 tray-icon.so "${pkgdir}/usr/lib/localsend/tray-icon.so"

  # Swaybar looks these up by name. Papirus-Dark's panel dirs are
  # symlinks into Papirus, owned by papirus-icon-theme, so a file
  # installed on the Dark path collides with that package. The white
  # mark goes in Papirus (the Dark bar follows the link). The black
  # mark goes in Papirus-Light, which has its own panel dirs.
  local img="${srcdir}/opt/localsend_app/data/flutter_assets/assets/img"
  local size
  for size in 16 22 24; do
    install -Dm644 "${img}/logo-32-white.png" \
      "${pkgdir}/usr/share/icons/Papirus/${size}x${size}/panel/localsend-tray.png"
    install -Dm644 "${img}/logo-32-black.png" \
      "${pkgdir}/usr/share/icons/Papirus-Light/${size}x${size}/panel/localsend-tray.png"
    install -Dm644 "${img}/logo-32-white.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/localsend-tray.png"
  done
}
