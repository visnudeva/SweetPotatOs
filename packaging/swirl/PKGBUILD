# Maintainer: visnudeva
pkgname=swirl
pkgver=1.13.0.r8567.gcd070469
pkgrel=12
pkgdesc='Scrolling tiling Wayland compositor with its bar, IPC client, nag, and menu'
arch=('x86_64')
url='https://github.com/visnudeva/swirl'
license=('MIT')
depends=(
  cairo
  gdk-pixbuf2
  json-c
  libdrm
  libevdev
  libinput
  libxcb
  libxkbcommon
  pango
  pcre2
  pixman
  wayland
  xcb-util-wm
  lua
  glibc
  libliftoff
  libglvnd
  lcms2
  systemd-libs
  opengl-driver
  xcb-util-errors
  xcb-util-renderutil
  seatd
  glslang
  vulkan-icd-loader
  libdisplay-info
  libcap
  pango
)
makedepends=(
  git
  meson
  ninja
  scdoc
  wayland-protocols
  vulkan-headers
  xorgproto
  xorg-xwayland
  hwdata
)
conflicts=('sway')
replaces=('sway')
optdepends=(
  'wmenu: text menu used by swirlmenu'
  'swaybg: wallpaper'
  'swayidle: idle management'
  'swaylock: screen locker'
  'xorg-xwayland: X11 support'
  'xdg-desktop-portal-wlr: screen sharing'
  'xdg-desktop-portal-gtk: file picking'
)
provides=('wayland-compositor')
# Vendored wlroots 0.21 is under swirl/subprojects/ (Arch has no wlroots0.21 yet).
source=("git+https://github.com/visnudeva/swirl.git#commit=cd070469"
        '99-swirl-systemd-user.conf'
        'swirl-portals.conf'
        'overview-click-zoom.patch'
        'swaynag-no-reflow.patch'
        'swaynag-single-row.patch'
        'lone-column-maximize.patch')
sha256sums=('SKIP'
            '6ffeac6519d077e08cd2f50051fa5a1478ca0ccbd4be4e28be41a8d0ebded806'
            '7f240d2e4a711dd3d4bb390bf90495edea0d15fd9bbf5f10a828338107d9ad1c'
            'c294f28c3f9865ce1db88ae507cf4b53c8063f993becbe45588a724b83209858'
            'd47e24936b9e7e485f4c74f039e77a9681cdedaca80e9aa51ae0e2a2a6e2a442'
            'b54a64aad06cc9439c255dc6d50a2a83be648f157be0c6346be5cb32b6a4651c'
            'SKIP')

pkgver() {
  cd "${srcdir}/swirl"
  local ver
  if ver=$(git describe --long --tags 2>/dev/null); then
    printf '%s' "${ver}" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '1.13.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "${srcdir}/swirl"
  # Plain left-click in overview focuses the target and zooms back in
  # (Super+drag still moves windows between desktops while zoomed out).
  git apply "${srcdir}/overview-click-zoom.patch"
  # Power-off / exit confirmation stays above the status bar and does not reflow windows.
  git apply "${srcdir}/swaynag-no-reflow.patch"
  # The confirmation button sits on the message row, so the bar stays one line tall.
  git apply "${srcdir}/swaynag-single-row.patch"
  # A column left alone after an overview drag stays full width.
  git apply "${srcdir}/lone-column-maximize.patch"
}

build() {
  arch-meson swirl build \
    -D sd-bus-provider=libsystemd \
    -D werror=false \
    -D b_ndebug=true \
    -D scrollbar=true \
    -D scrollnag=true \
    -D swaymsg=true \
    -D default-wallpaper=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 swirl/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 swirl/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 99-swirl-systemd-user.conf "$pkgdir/etc/sway/config.d/99-swirl-systemd-user.conf"
  install -Dm644 swirl-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/swirl-portals.conf"
  install -Dm755 "${startdir}/swirlmenu" "${pkgdir}/usr/bin/swirlmenu"
  # Scripts, Displays, and the bar block still call the sway names.
  ln -s swirlbar "${pkgdir}/usr/bin/swaybar"
  ln -s swirlmsg "${pkgdir}/usr/bin/swaymsg"
  ln -s swirlnag "${pkgdir}/usr/bin/swaynag"
}
