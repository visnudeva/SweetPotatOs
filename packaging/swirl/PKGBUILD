pkgver() {
  cd "${srcdir}/swirl"
  local ver
  if ver=$(git describe --long --tags 2>/dev/null); then
    printf '%s' "${ver}" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '1.13.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "${srcdir}/swirl"
  # Plain left-click in overview focuses the target and zooms back in
  # (Super+drag still moves windows between desktops while zoomed out).
  git apply "${srcdir}/overview-click-zoom.patch"
  # Power-off / exit confirmation stays above the status bar and does not reflow windows.
  git apply "${srcdir}/swaynag-no-reflow.patch"
  # The confirmation button sits on the message row, so the bar stays one line tall.
  git apply "${srcdir}/swaynag-single-row.patch"
  # Power-off and exit buttons are capsules, matching the rounded frames.
  git apply "${srcdir}/swaynag-rounded-buttons.patch"
  # Enter confirms the bar. Escape dismisses it.
  git apply "${srcdir}/swaynag-keyboard.patch"
  # Power menu: no X button, click outside dismisses, fullscreen click-away.
  git apply "${srcdir}/swaynag-power-menu.patch"
  # Power menu floats with the same rounded accent panel as swirlbar when frames are on.
  git apply "${srcdir}/swaynag-rounded-panel.patch"
  # A column left alone after an overview drag stays full width.
  git apply "${srcdir}/lone-column-maximize.patch"
  # Multi-desktop overview fits every column stripe into each workspace.
  git apply "${srcdir}/overview-fit-strips.patch"
  # Stack desktops as equal-height horizontal stripes (stable click targets).
  git apply "${srcdir}/overview-coverflow-stripes.patch"
  # Floating rounded swirlbar with accent border (driven by frame.sh + frames).
  git apply "${srcdir}/swaybar-rounded-frame.patch"
  # Re-apply layer margins on every redraw so Mod+Ctrl+g floats the bar live.
  git apply "${srcdir}/swaybar-gaps-margin-refresh.patch"
  # Gap mode keeps full window borders (lone window + overview); none clears smart.
  git apply "${srcdir}/hide-edge-borders-gaps.patch"
  # Overview: consistent scale rounding so right/bottom borders stay visible.
  git apply "${srcdir}/overview-border-clip.patch"
  # Overview: >=2px stroke + square corners so 1px zoom jank cannot drop a side.
  git apply "${srcdir}/overview-border-min-stroke.patch"

  # App / Wi-Fi / wallpaper menu selection corners match window frames.
  cd "${srcdir}/wmenu"
  patch -p1 < "${srcdir}/wmenu-selection-radius.patch"
  # Floating swirlbar: menu clears the bar and shares its side inset.
  patch -p1 < "${srcdir}/wmenu-layer-margins.patch"
}

build() {
  arch-meson swirl build \
    -D sd-bus-provider=libsystemd \
    -D werror=false \
    -D b_ndebug=true \
    -D scrollbar=true \
    -D scrollnag=true \
    -D swaymsg=true \
    -D default-wallpaper=false
  meson compile -C build
  arch-meson "${srcdir}/wmenu" "${srcdir}/wmenu-build"
  meson compile -C "${srcdir}/wmenu-build"
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 swirl/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 swirl/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 99-swirl-systemd-user.conf "$pkgdir/etc/sway/config.d/99-swirl-systemd-user.conf"
  install -Dm644 swirl-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/swirl-portals.conf"
  install -Dm755 "${startdir}/swirlmenu" "${pkgdir}/usr/bin/swirlmenu"
  # Patched wmenu used by swirlmenu (-r matches frame radius). Keep Arch wmenu too.
  install -Dm755 "${srcdir}/wmenu-build/wmenu" "${pkgdir}/usr/lib/swirl/wmenu"
  # Scripts, Displays, and the bar block still call the sway names.
  ln -s swirlbar "${pkgdir}/usr/bin/swaybar"
  ln -s swirlmsg "${pkgdir}/usr/bin/swaymsg"
  ln -s swirlnag "${pkgdir}/usr/bin/swaynag"

  # Plain Arch has no ~/.config/swirl. This session is what starts then.
  # A home config is preferred, so SweetPotatOs keeps its own.
  local root="${SWEETPOTATOS_ROOT:-$(cd "${startdir}/../.." && pwd)}"
  local scripts="${root}/profile/airootfs/etc/skel/.config/swirl/scripts"
  local share="${pkgdir}/usr/share/swirl"
  install -Dm644 "${startdir}/session/config" "${pkgdir}/etc/swirl/config"
  install -Dm755 "${scripts}/applauncher.sh" "${share}/scripts/applauncher.sh"
  install -Dm755 "${scripts}/status.sh" "${share}/scripts/status.sh"
  install -Dm755 "${scripts}/workspace-dots.sh" "${share}/scripts/workspace-dots.sh"
  install -Dm755 "${scripts}/autotile.lua" "${share}/scripts/autotile.lua"
  install -Dm644 "${scripts}/autotile_lib.lua" "${share}/scripts/autotile_lib.lua"
  install -Dm755 "${scripts}/confirm.sh" "${share}/scripts/confirm.sh"
  install -Dm755 "${scripts}/poweroff.sh" "${share}/scripts/poweroff.sh"
  install -Dm755 "${scripts}/suspend.sh" "${share}/scripts/suspend.sh"
  install -Dm755 "${scripts}/power-menu.sh" "${share}/scripts/power-menu.sh"
  install -Dm644 "${root}/profile/airootfs/etc/skel/.config/swaylock/config" \
    "${share}/swaylock.conf"
  install -Dm644 \
    "${root}/profile/airootfs/etc/skel/.local/share/backgrounds/SPONeonKanjiDefault.png" \
    "${share}/backgrounds/SPONeonKanjiDefault.png"
}
