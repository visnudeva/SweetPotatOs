+static void swipe_commit_tracker(struct seatop_default_event *seatop,
+		uint8_t fingers, double dx, double dy) {
+	gesture_tracker_begin(&seatop->gestures, GESTURE_TYPE_SWIPE, fingers);
+	gesture_tracker_update(&seatop->gestures, dx, dy, NAN, NAN);
+	seatop->swipe_mode = SEATOP_SWIPE_TRACKER;
+}
+
+static bool swipe_commit_scroll(struct sway_seat *seat,
+		struct seatop_default_event *seatop, double dx, double dy) {
+	if (!layout_scroll_begin(seat)) {
+		return false;
+	}
+	layout_scroll_update(seat, dx, dy, config->gesture_scroll_sentitivity);
+	seatop->swipe_mode = SEATOP_SWIPE_SCROLL;
+	return true;
+}
+
+static void swipe_resolve_axis(struct sway_seat *seat,
+		struct seatop_default_event *seatop) {
+	double ax = fabs(seatop->swipe_dx);
+	double ay = fabs(seatop->swipe_dy);
+	if (ay > ax) {
+		/* Vertical wins: bindgesture (workspace / overview), like niri. */
+		swipe_commit_tracker(seatop, seatop->swipe_fingers,
+			seatop->swipe_dx, seatop->swipe_dy);
+		return;
+	}
+	/* Horizontal wins: continuous strip scroll. */
+	if (!swipe_commit_scroll(seat, seatop, seatop->swipe_dx, seatop->swipe_dy)) {
+		/* Nothing to scroll; still allow a matching bind if any. */
+		swipe_commit_tracker(seatop, seatop->swipe_fingers,
+			seatop->swipe_dx, seatop->swipe_dy);
+	}
+}
