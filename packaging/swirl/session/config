# Session installed with the swirl package (/etc/swirl/config).
# ~/.config/swirl/config replaces this file. SweetPotatOs ships that home
# config, so a SweetPotatOs login does not use this one.
include /etc/sway/config.d/*

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu /usr/share/swirl/scripts/applauncher.sh
set $lockcmd swaylock -f -C /usr/share/swirl/swaylock.conf

output * bg /usr/share/swirl/backgrounds/SPONeonKanjiDefault.png fill

exec swayidle -w \
    timeout 300 '$lockcmd' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lockcmd'

input type:touchpad {
    dwt enabled
    tap enabled
    drag_lock disabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:keyboard {
    xkb_layout "us"
}

default_orientation horizontal
workspace_layout horizontal
layout_default_width 1.0
layout_default_height 1.0
maximize_if_single false
workspace_next_on_output_create_empty true
gesture_scroll_enable true
gesture_scroll_fingers 3
gesture_scroll_sensitivity 1.0
bindgesture swipe:4:up workspace next_on_output
bindgesture swipe:4:down workspace prev_on_output

lua /usr/share/swirl/scripts/autotile.lua

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
default_decoration border_radius 8

client.focused           #a73b50 #1d1f21 #ffffff #a73b50 #a73b50
client.focused_inactive  #3a3a3a #1d1f21 #aaaaaa #3a3a3a #3a3a3a
client.unfocused         #3a3a3a #1d1f21 #888888 #3a3a3a #3a3a3a
client.urgent            #f79b29 #f79b29 #1d1f21 #a73b50 #f79b29
client.placeholder       #1d1f21 #1d1f21 #888888 #1d1f21 #1d1f21
client.background        #1d1f21
client.sticky            #a73b50 #1d1f21 #ffffff #a73b50 #a73b50
client.sticky_focused    #a73b50 #1d1f21 #ffffff #a73b50 #a73b50
client.pinned            #3a3a3a #1d1f21 #aaaaaa #a73b50 #3a3a3a
client.pinned_focused    #a73b50 #1d1f21 #ffffff #a73b50 #a73b50
client.selected          #f79b29 #1d1f21 #ffffff #f79b29 #f79b29
client.selected_focused  #a73b50 #1d1f21 #ffffff #a73b50 #a73b50

floating_modifier $mod normal

bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+space exec $menu
bindsym $mod+l exec $lockcmd
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec /usr/share/swirl/scripts/confirm.sh -t warning -m 'You pressed the exit shortcut. Do you really want to exit Swirl? This will end your Wayland session.' -B 'Yes, exit Swirl' 'swaymsg exit'
bindsym $mod+o exec /usr/share/swirl/scripts/power-menu.sh
bindsym $mod+Escape exec /usr/share/swirl/scripts/power-menu.sh

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+Left focus left
bindsym $mod+Up workspace prev_on_output; scale_workspaces disable
bindsym $mod+Down workspace next_on_output; scale_workspaces disable
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1; scale_workspaces disable
bindsym $mod+2 workspace number 2; scale_workspaces disable
bindsym $mod+3 workspace number 3; scale_workspaces disable
bindsym $mod+4 workspace number 4; scale_workspaces disable
bindsym $mod+5 workspace number 5; scale_workspaces disable
bindsym $mod+6 workspace number 6; scale_workspaces disable
bindsym $mod+7 workspace number 7; scale_workspaces disable
bindsym $mod+8 workspace number 8; scale_workspaces disable
bindsym $mod+9 workspace number 9; scale_workspaces disable
bindsym $mod+0 workspace number 10; scale_workspaces disable
bindsym $mod+ampersand workspace number 1; scale_workspaces disable
bindsym $mod+eacute workspace number 2; scale_workspaces disable
bindsym $mod+quotedbl workspace number 3; scale_workspaces disable
bindsym $mod+apostrophe workspace number 4; scale_workspaces disable
bindsym $mod+parenleft workspace number 5; scale_workspaces disable
bindsym $mod+minus workspace number 6; scale_workspaces disable
bindsym $mod+egrave workspace number 7; scale_workspaces disable
bindsym $mod+underscore workspace number 8; scale_workspaces disable
bindsym $mod+ccedilla workspace number 9; scale_workspaces disable
bindsym $mod+agrave workspace number 10; scale_workspaces disable
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10
bindsym $mod+Shift+ampersand move container to workspace number 1; workspace number 1
bindsym $mod+Shift+eacute move container to workspace number 2; workspace number 2
bindsym $mod+Shift+quotedbl move container to workspace number 3; workspace number 3
bindsym $mod+Shift+apostrophe move container to workspace number 4; workspace number 4
bindsym $mod+Shift+parenleft move container to workspace number 5; workspace number 5
bindsym $mod+Shift+minus move container to workspace number 6; workspace number 6
bindsym $mod+Shift+egrave move container to workspace number 7; workspace number 7
bindsym $mod+Shift+underscore move container to workspace number 8; workspace number 8
bindsym $mod+Shift+ccedilla move container to workspace number 9; workspace number 9
bindsym $mod+Shift+agrave move container to workspace number 10; workspace number 10

bindsym $mod+Ctrl+Up move container to workspace prev_on_output
bindsym $mod+Ctrl+Down move container to workspace next_on_output
bindsym --no-repeat $mod+Tab scale_workspaces toggle
bindsym --no-repeat $mod+Shift+Tab scale_workspace overview

bindsym $mod+Shift+f fullscreen
bindsym $mod+a floating toggle
bindsym $mod+Shift+a focus parent

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+r mode "resize"

exec_always /usr/share/swirl/scripts/workspace-dots.sh

bar {
    position top
    status_command /usr/share/swirl/scripts/status.sh
    tray_padding 1
    font pango:Noto Sans 10
    pango_markup yes
    strip_workspace_numbers yes
    workspace_min_width 0
    scroller_indicator no
    trails_indicator no

    colors {
        statusline #ffffff
        background #1d1f21
        separator  #a73b50
        focused_workspace     #1d1f21 #1d1f21 #a73b50
        active_workspace      #1d1f21 #1d1f21 #f79b29
        inactive_workspace    #1d1f21 #1d1f21 #f79b29
        urgent_workspace      #1d1f21 #1d1f21 #ffffff
        binding_mode          #f79b29 #f79b29 #1d1f21
    }
}

exec --no-startup-id sh -c '/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 || /usr/lib/xfce-polkit/xfce-polkit || /usr/lib/xfce4/xfce-polkit || true'
