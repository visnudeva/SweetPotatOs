+		/* Partition scaled boxes with round() so adjacent tiles share an
+		 * edge instead of overlapping by ~1px. Floor+ceil made the left
+		 * neighbour cover the next window's left border; focus-follows-
+		 * mouse then made that depend on hover direction. */
+		double sx = dst_fbox.x * scale + dx;
+		double sy = dst_fbox.y * scale + dy;
+		double sw = dst_fbox.width * scale;
+		double sh = dst_fbox.height * scale;
+		dst_fbox.x = round(sx);
+		dst_fbox.y = round(sy);
+		dst_fbox.width = round(sx + sw) - round(sx);
+		dst_fbox.height = round(sy + sh) - round(sy);
