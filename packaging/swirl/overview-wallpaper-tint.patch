@@ -386,6 +386,35 @@ bool layout_overview_workspaces_enabled() {
 	return root ? root->overview : false;
 }
 
+void overview_wallpaper_tint_apply(void) {
+	if (!root || !config) {
+		return;
+	}
+	bool on = layout_overview_workspaces_enabled();
+	float color[4];
+	const float *ind = config->border_colors.focused.indicator;
+	/* Premultiplied (wlroots requires it). Straight RGB+alpha looked opaque. */
+	float a = ind[3] * 0.06f;
+	color[0] = ind[0] * a;
+	color[1] = ind[1] * a;
+	color[2] = ind[2] * a;
+	color[3] = a;
+	for (int i = 0; i < root->outputs->length; ++i) {
+		struct sway_output *output = root->outputs->items[i];
+		struct wlr_scene_rect *rect = output->overview_wallpaper_tint;
+		if (!rect) {
+			continue;
+		}
+		if (on) {
+			wlr_scene_rect_set_size(rect, output->width, output->height);
+			wlr_scene_rect_set_color(rect, color);
+			wlr_scene_node_set_position(&rect->node, 0, 0);
+			wlr_scene_node_raise_to_top(&rect->node);
+		}
+		wlr_scene_node_set_enabled(&rect->node, on);
+	}
+}
