diff --git a/sway/input/seatop_default.c b/sway/input/seatop_default.c
--- a/sway/input/seatop_default.c
+++ b/sway/input/seatop_default.c
@@ -451,7 +451,20 @@
 			}
 		}
 
-		/* Exit overview before focus so zoom is a single animation. */
+		/* Overview + plain LMB on a tiled window: start a drag threshold
+		 * (niri-like move between desktops). Click without moving zooms in.
+		 * Empty workspace clicks still zoom immediately (handled above). */
+		if (button == BTN_LEFT && !mod_pressed &&
+				layout_overview_workspaces_enabled() &&
+				!is_floating_or_child && cont &&
+				cont->pending.fullscreen_mode == FULLSCREEN_NONE &&
+				config->tiling_drag) {
+			seat_set_focus(seat, node);
+			transaction_commit_dirty();
+			seatop_begin_move_tiling_threshold(seat, cont);
+			return;
+		}
+		/* Floating / other overview clicks: zoom into the selection. */
 		bool zoomed = button == BTN_LEFT && !mod_pressed &&
 			overview_exit_on_select(cont->pending.workspace);
 		seat_set_focus(seat, node);
diff --git a/sway/input/seatop_move_tiling.c b/sway/input/seatop_move_tiling.c
--- a/sway/input/seatop_move_tiling.c
+++ b/sway/input/seatop_move_tiling.c
@@ -96,21 +96,39 @@
 		e->target_edge = WLR_EDGE_NONE;
 		return;
 	}
+	/* Overview is for moving between desktops (niri-like). Dropping onto
+	 * another window here used to restack columns so individual grabs broke. */
+	if (layout_overview_workspaces_enabled()) {
+		struct sway_workspace *ws = NULL;
+		if (node->type == N_WORKSPACE) {
+			ws = node->sway_workspace;
+		} else if (node->type == N_CONTAINER) {
+			ws = node->sway_container->pending.workspace;
+		}
+		if (!ws) {
+			set_target_node(e, NULL);
+			e->target_edge = WLR_EDGE_NONE;
+			return;
+		}
+		set_target_node(e, &ws->node);
+		e->target_edge = WLR_EDGE_NONE;
+		struct sway_output *output = ws->output;
+		struct wlr_box drop_box = {
+			.x = output->lx + ws->jump.x,
+			.y = output->ly + ws->jump.y,
+			.width = ws->jump.width,
+			.height = ws->jump.height,
+		};
+		update_indicator(e, &drop_box);
+		return;
+	}
 	if (node->type == N_WORKSPACE) {
 		// Empty workspace
 		set_target_node(e, node);
 		e->target_edge = WLR_EDGE_NONE;
 
 		struct wlr_box drop_box;
-		if (layout_overview_workspaces_enabled()) {
-			struct sway_output *output = node->sway_workspace->output;
-			drop_box.x = output->lx + node->sway_workspace->jump.x;
-			drop_box.y = output->ly + node->sway_workspace->jump.y;
-			drop_box.width = node->sway_workspace->jump.width;
-			drop_box.height = node->sway_workspace->jump.height;
-		} else {
-			workspace_get_box(node->sway_workspace, &drop_box);
-		}
+		workspace_get_box(node->sway_workspace, &drop_box);
 		update_indicator(e, &drop_box);
 		return;
 	}
@@ -241,6 +259,13 @@
 	struct seatop_move_tiling_event *e = seat->seatop_data;
 
 	if (!e->target_node) {
+		/* Plain click in overview (threshold never reached): zoom in. */
+		if (!e->threshold_reached && layout_overview_workspaces_enabled() &&
+				e->con) {
+			layout_overview_workspaces(false);
+			seat_set_focus(seat, &e->con->node);
+			transaction_commit_dirty();
+		}
 		seatop_begin_default(seat);
 		return;
 	}
@@ -252,8 +277,11 @@
 	enum wlr_edges edge = e->target_edge;
 
 	if (target_node->type == N_WORKSPACE) {
-		// Moving container into workspace
-		layout_drag_container_to_workspace(con, workspace);
+		/* Same-desktop drop in overview: leave layout alone. */
+		if (!(layout_overview_workspaces_enabled() &&
+				con->pending.workspace == workspace)) {
+			layout_drag_container_to_workspace(con, workspace);
+		}
 	} else {
 		layout_drag_container_to_container(con, target_node->sway_container, workspace, edge);
 	}
