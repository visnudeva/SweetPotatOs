+void layout_expand_lone_column(struct sway_workspace *workspace) {
+	struct sway_container *column;
+	int i;
+
+	if (!workspace || !workspace->tiling || workspace->tiling->length != 1) {
+		return;
+	}
+	column = workspace->tiling->items[0];
+	if (!column) {
+		return;
+	}
+	/* Direct fractions. OPERATION_FOCUS will not resize a column that
+	 * set_size left in TOGGLE_STATE_NONE_FORCED, and a later unfocus
+	 * would pop a saved half width. */
+	column->width_fraction = 1.0;
+	column->height_fraction = 1.0;
+	column->toggle_size.state = TOGGLE_STATE_NONE_FORCED;
+	if (column->pending.children) {
+		for (i = 0; i < column->pending.children->length; ++i) {
+			struct sway_container *child = column->pending.children->items[i];
+			if (!child) {
+				continue;
+			}
+			child->width_fraction = 1.0;
+			child->height_fraction = 1.0;
+			child->toggle_size.state = TOGGLE_STATE_NONE_FORCED;
+		}
+	}
+	arrange_workspace(workspace);
+	node_set_dirty(&column->node);
+	node_set_dirty(&workspace->node);
+}
