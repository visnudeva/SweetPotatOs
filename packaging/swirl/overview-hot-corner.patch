+/* Top-left corner of any output toggles the multi-desktop overview (niri-like). */
+#define OVERVIEW_HOT_CORNER_PX 1
+
+static void cursor_check_overview_hot_corner(struct sway_cursor *cursor) {
+	if (root->fullscreen_global || !root->outputs || !root->outputs->length) {
+		cursor->overview_hot_corner = false;
+		return;
+	}
+	const double cx = cursor->cursor->x;
+	const double cy = cursor->cursor->y;
+	bool in_corner = false;
+	for (int i = 0; i < root->outputs->length; ++i) {
+		struct sway_output *output = root->outputs->items[i];
+		if (!output || !output->enabled) {
+			continue;
+		}
+		if (cx >= output->lx && cx < output->lx + OVERVIEW_HOT_CORNER_PX &&
+				cy >= output->ly && cy < output->ly + OVERVIEW_HOT_CORNER_PX) {
+			in_corner = true;
+			break;
+		}
+	}
+	if (in_corner && !cursor->overview_hot_corner) {
+		layout_overview_workspaces(!layout_overview_workspaces_enabled());
+		transaction_commit_dirty();
+	}
+	cursor->overview_hot_corner = in_corner;
+}
