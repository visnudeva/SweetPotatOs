+	struct wlr_scene_tree *dest = reserve > 0
+		? output->layers.shell_top : output->layers.shell_bottom;
+	for (int i = 0; i < npanels; ++i) {
+		struct wlr_scene_node *node = &panels[i]->scene->tree->node;
+		if (node->parent != dest) {
+			wlr_scene_node_reparent(node, dest);
