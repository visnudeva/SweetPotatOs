+void layer_finish_confirmation(struct sway_output *output, struct wlr_box *usable_area) {
+	int reserve = confirmation_reserve(output);
+	// The yellow bar keeps its strip so the status bar sits under it.
+	// Windows keep the area they had before the confirmation opened.
+	if (usable_area && reserve > 0) {
+		usable_area->y -= reserve;
+		usable_area->height += reserve;
+		if (usable_area->y < 0) {
+			usable_area->height += usable_area->y;
+			usable_area->y = 0;
+		}
+		if (usable_area->height < 0) {
+			usable_area->height = 0;
+		}
+	}
+
+	struct wlr_scene_tree *trees[] = {
