+static void swaynag_activate_dismiss(struct swaynag *swaynag) {
+	for (int i = 0; i < swaynag->buttons->length; ++i) {
+		struct swaynag_button *button = swaynag->buttons->items[i];
+		if (button->type == SWAYNAG_ACTION_DISMISS) {
+			swaynag_button_execute(swaynag, button);
+			return;
+		}
+	}
+	swaynag->run_display = false;
+}
+
+static void swaynag_activate_confirm(struct swaynag *swaynag) {
+	if (swaynag->confirmed) {
+		return;
+	}
+	for (int i = 0; i < swaynag->buttons->length; ++i) {
+		struct swaynag_button *button = swaynag->buttons->items[i];
+		if (button->type == SWAYNAG_ACTION_COMMAND && button->action) {
+			swaynag->confirmed = true;
+			swaynag_button_execute(swaynag, button);
+			return;
+		}
+	}
+}
+
+static void swaynag_keyboard_finish(struct swaynag_keyboard *keyboard) {
+	if (keyboard->state) {
+		xkb_state_unref(keyboard->state);
+		keyboard->state = NULL;
+	}
+	if (keyboard->keymap) {
+		xkb_keymap_unref(keyboard->keymap);
+		keyboard->keymap = NULL;
+	}
+	if (keyboard->keyboard) {
+		wl_keyboard_destroy(keyboard->keyboard);
+		keyboard->keyboard = NULL;
+	}
+	keyboard->key_down = false;
+}
+
+static void keyboard_keymap(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t format, int32_t fd, uint32_t size) {
+	struct swaynag_seat *seat = data;
+	if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1 || !seat->swaynag->xkb_context) {
+		close(fd);
+		return;
+	}
+
+	char *map_shm = mmap(NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+	if (map_shm == MAP_FAILED) {
+		close(fd);
+		return;
+	}
+
+	struct xkb_keymap *keymap = xkb_keymap_new_from_string(
+			seat->swaynag->xkb_context, map_shm,
+			XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS);
+	munmap(map_shm, size);
+	close(fd);
+	if (!keymap) {
+		return;
+	}
+
+	struct xkb_state *state = xkb_state_new(keymap);
+	if (!state) {
+		xkb_keymap_unref(keymap);
+		return;
+	}
+
+	if (seat->keyboard.state) {
+		xkb_state_unref(seat->keyboard.state);
+	}
+	if (seat->keyboard.keymap) {
+		xkb_keymap_unref(seat->keyboard.keymap);
+	}
+	seat->keyboard.keymap = keymap;
+	seat->keyboard.state = state;
+}
+
+static void keyboard_key(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t serial, uint32_t time, uint32_t key, uint32_t key_state) {
+	struct swaynag_seat *seat = data;
+	if (key_state != WL_KEYBOARD_KEY_STATE_PRESSED) {
+		seat->keyboard.key_down = false;
+		return;
+	}
+	if (seat->keyboard.key_down || !seat->keyboard.state) {
+		return;
+	}
+	seat->keyboard.key_down = true;
+
+	xkb_keysym_t sym = xkb_state_key_get_one_sym(
+			seat->keyboard.state, key + 8);
+	if (sym == XKB_KEY_Escape) {
+		swaynag_activate_dismiss(seat->swaynag);
+	} else if (sym == XKB_KEY_Return || sym == XKB_KEY_KP_Enter) {
+		swaynag_activate_confirm(seat->swaynag);
+	}
+}
+
+static void keyboard_modifiers(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t serial, uint32_t mods_depressed, uint32_t mods_latched,
+		uint32_t mods_locked, uint32_t group) {
+	struct swaynag_seat *seat = data;
+	if (!seat->keyboard.state) {
+		return;
+	}
+	xkb_state_update_mask(seat->keyboard.state, mods_depressed, mods_latched,
+			mods_locked, 0, 0, group);
+}
+
+static const struct wl_keyboard_listener keyboard_listener = {
+	.keymap = keyboard_keymap,
+	.enter = nop,
+	.leave = nop,
+	.key = keyboard_key,
+	.modifiers = keyboard_modifiers,
+	.repeat_info = nop,
+};
