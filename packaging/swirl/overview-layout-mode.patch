+
+
+struct cmd_results *cmd_overview_layout(int argc, char **argv) {
+	struct cmd_results *error;
+	if ((error = checkarg(argc, "overview_layout", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	if (strcmp(argv[0], "stripe") == 0) {
+		config->overview_layout = OVERVIEW_LAYOUT_STRIPE;
+	} else if (strcmp(argv[0], "wall") == 0) {
+		config->overview_layout = OVERVIEW_LAYOUT_WALL;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'overview_layout <stripe|wall>'");
+	}
+	layout_overview_workspaces_recompute_scale();
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
