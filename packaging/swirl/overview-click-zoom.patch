+/**
+ * Leave multi-desktop / current-desktop overview after selecting a target.
+ * Used for click-to-zoom; Super+drag (mod pressed) must not call this.
+ */
+static bool overview_exit_on_select(struct sway_workspace *workspace) {
+	bool exited = false;
+	if (layout_overview_workspaces_enabled()) {
+		layout_overview_workspaces(false);
+		exited = true;
+	}
+	if (workspace && layout_overview_mode(workspace) != OVERVIEW_DISABLED) {
+		layout_overview_set(workspace, OVERVIEW_DISABLED);
+		exited = true;
+	}
+	return exited;
+}
