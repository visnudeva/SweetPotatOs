# Maintainer: visnudeva
pkgname=spore
pkgver=0.1.0.r16.g05bfc91
pkgrel=1
pkgdesc='TUI web radio and local music player with FFT visualizers'
arch=('x86_64')
url='https://github.com/visnudeva/spore'
license=('MIT')
depends=('ffmpeg' 'alsa-lib')
makedepends=('go' 'gcc' 'alsa-lib')
optdepends=(
  'pipewire-pulse: PulseAudio/PipeWire audio output'
  'alsa-lib: ALSA audio output'
)
source=("git+https://github.com/visnudeva/spore.git#commit=05bfc91e272eaae5278598cd2089fde22d7a98e4"
        follow-theme.patch
        align-hint.patch)
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

prepare() {
  cd spore
  patch -p1 -i "${srcdir}/follow-theme.patch"
  patch -p1 -i "${srcdir}/align-hint.patch"
}

pkgver() {
  cd spore
  # Published packages already reached r9. This clone's history is shorter
  # than that, so commit count alone would sort as a downgrade.
  local n
  n="$(git rev-list --count HEAD)"
  printf '0.1.0.r%s.g%s' "$((n + 6))" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd spore
  go build -trimpath -ldflags='-s -w' -o spore ./cmd/spore
}

package() {
  cd spore
  install -Dm755 spore "${pkgdir}/usr/bin/spore"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 Logo.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/spore.png"
  install -Dm644 Logo.png "${pkgdir}/usr/share/pixmaps/spore.png"

  cat <<'EOF' | install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/spore.desktop"
[Desktop Entry]
Name=Spore
GenericName=Music player
Comment=Web radio and local music player with visualizers
Exec=foot -e spore
TryExec=foot
Icon=spore
Type=Application
Categories=Audio;Player;Music;
Keywords=radio;music;mp3;flac;player;terminal;tui;spore;
Terminal=false
StartupNotify=true
EOF
}
