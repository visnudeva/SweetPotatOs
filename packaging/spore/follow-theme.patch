+package ui
+
+import (
+	"charm.land/lipgloss/v2"
+
+	"github.com/spore-player/spore/internal/vis"
+)
+
+// init copies the desktop theme onto the screen styles.
+// vis.init has already loaded ~/.config/sweetpotatos/tui-colors.
+func init() {
+	tabActiveStyle = lipgloss.NewStyle().Bold(true).Foreground(vis.ColorTitle).Underline(true)
+	tabInactiveStyle = lipgloss.NewStyle().Foreground(vis.ColorDim)
+	headerStyle = lipgloss.NewStyle().Foreground(vis.ColorAccent).Bold(true)
+	dimStyle = lipgloss.NewStyle().Foreground(vis.ColorDim)
+	errorStyle = lipgloss.NewStyle().Foreground(vis.ColorError)
+	greenStyle = lipgloss.NewStyle().Foreground(vis.ColorPlaying)
+
+	itemSelected = lipgloss.NewStyle().Bold(true).Foreground(vis.ColorTitle)
+	itemNormal = lipgloss.NewStyle().Foreground(vis.ColorText)
+	itemDim = lipgloss.NewStyle().Foreground(vis.ColorDim)
+	favStar = lipgloss.NewStyle().Foreground(vis.ColorAccent)
+}
