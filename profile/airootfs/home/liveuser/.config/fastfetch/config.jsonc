{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "/usr/local/share/sweetpotatos/SPLogo.png",
    "width": 28,
    "height": 14,
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#a73b50",
      "title": "#f79b29"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    {
      "type": "de",
      "format": "Swirl"
    },
    {
      "type": "wm",
      "format": "Swirl ({protocol-name})"
    },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
