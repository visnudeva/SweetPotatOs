# SweetPotato swaylock (swaylock-effects)
# Colors: potato red/pink #a73b50, potato orange #f79b29, charcoal #1d1f21
#
# Theme colors first — if a later effects-only option fails to parse,
# load_config stops and would otherwise leave a stock white lock screen.

daemonize
show-failed-attempts
# Live ISO: liveuser has an empty password — allow Enter to unlock.
# (Installed systems keep ignore-empty-password via skel.)

# Plain surface (no image). theme.sh rewrites SPO-THEME colors.
# SPO-THEME-START
color=1d1f21
# SPO-THEME-END
scaling=solid_color

# Larger ring so clock + date (date scales with radius) stay readable
indicator-radius=180
indicator-thickness=8
font=Noto Sans Bold
font-size=42

# Inside uses the highlight; ring and clock text use the accent.
# SPO-LOCK-START
inside-color=f79b29ff
inside-clear-color=f79b29ff
inside-ver-color=f79b29ff
inside-wrong-color=f79b29ff
inside-caps-lock-color=f79b29ff

ring-color=a73b50ff
ring-clear-color=a73b50ff
ring-ver-color=a73b50ff
ring-wrong-color=a73b50ff
ring-caps-lock-color=a73b50ff

key-hl-color=f79b29ff
bs-hl-color=a73b50ff
caps-lock-key-hl-color=f79b29ff
caps-lock-bs-hl-color=a73b50ff
# SPO-LOCK-END

line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000

separator-color=00000000

# SPO-TEXT-START
text-color=a73b50ff
text-clear-color=a73b50ff
text-ver-color=a73b50ff
text-wrong-color=a73b50ff
text-caps-lock-color=a73b50ff

layout-bg-color=1d1f21cc
layout-border-color=a73b50ff
layout-text-color=ffffffff
# SPO-TEXT-END

# swaylock-effects: always show indicator + clock while locked
indicator
indicator-idle-visible
clock
timestr=%H:%M
datestr=%a %d %b
