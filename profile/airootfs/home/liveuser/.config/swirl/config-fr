# SweetPotato / Swirl config (French AZERTY)
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher (desktop apps only)
set $menu ~/.config/swirl/scripts/applauncher.sh
# Your preferred web browser
set $web firefox
# Your preferred file browser
set $file thunar
# Your preferred editor
set $editor geany

### Output configuration
#
# Wallpaper is restored by waypaper --restore on every start.

exec_always waypaper --restore
exec kanshi

### Idle configuration
#
# Live ISO: caffeine on by default so install does not sleep/lock
exec ~/.config/swirl/scripts/caffeine.sh on
#

# Calamares (Wayland) updates systemd-localed; push that into Swirl live
exec_always --no-startup-id /usr/local/bin/sweetpotatos-sway-xkb-watch
### Input configuration
#
input type:touchpad {
    dwt enabled
    tap enabled
    drag_lock disabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:keyboard {
    xkb_layout "fr"
}

### Swirl layout (niri-like)
# Columns on an infinite horizontal strip. Autotile pairs columns:
# odd last = full width, even = 50/50 (see scripts/autotile.lua).
default_orientation horizontal
workspace_layout horizontal
layout_default_width 1.0
layout_default_height 1.0
# Autotile script owns single-window maximize (set_size blocks maximize_if_single).
maximize_if_single false
workspace_next_on_output_create_empty true

# 3-finger: continuous scroll along the window strip (must not bind 3-finger
# swipes, or layout scroll is stolen).
gesture_scroll_enable true
gesture_scroll_fingers 3
gesture_scroll_sensitivity 1.0

# 4-finger vertical: dynamic workspaces (traditional direction: swipe up → next)
bindgesture swipe:4:up workspace next_on_output
bindgesture swipe:4:down workspace prev_on_output

# Autotile: pair columns (odd last = full, even = 50/50)
lua ~/.config/swirl/scripts/autotile.lua

seat * xcursor_theme capitaine-cursors 24

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+q kill

    # App launcher
    bindsym $mod+space exec $menu

    # Wi‑Fi / NetworkManager (swaybar tray clicks don't open menus)
    bindsym $mod+n exec networkmanager_dmenu

    # Install SweetPotatOs to disk
    bindsym $mod+i exec sweetpotatos-calamares

    # Wallpaper selector
    bindsym $mod+Shift+w exec waypaper

    # Start your web browser
    bindsym $mod+w exec $web

    # Start your file browser
    bindsym $mod+f exec $file

    # Start your editor
    bindsym $mod+e exec $editor

    # Lock screen (Mod+l — vim focus-right moved to arrow keys only)
    bindsym $mod+l exec swaylock -f

    # Caffeine: toggle idle lock / display off (lid-close still suspends)
    bindsym $mod+c exec ~/.config/swirl/scripts/caffeine.sh

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit Swirl (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit Swirl? This will end your Wayland session.' -B 'Yes, exit Swirl' 'swaymsg exit'

    # Power off
    bindsym $mod+o exec swaynag -t warning -m 'Power off this machine?' -B 'Yes, power off' 'systemctl poweroff'
#
# Moving around:
#
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    # $right is "l" — reserved for lock; use arrows for focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces (AZERTY):
#
    bindsym $mod+ampersand workspace number 1
    bindsym $mod+eacute workspace number 2
    bindsym $mod+quotedbl workspace number 3
    bindsym $mod+apostrophe workspace number 4
    bindsym $mod+parenleft workspace number 5
    bindsym $mod+minus workspace number 6
    bindsym $mod+egrave workspace number 7
    bindsym $mod+underscore workspace number 8
    bindsym $mod+ccedilla workspace number 9
    bindsym $mod+agrave workspace number 10
    bindsym $mod+Shift+ampersand move container to workspace number 1
    bindsym $mod+Shift+eacute move container to workspace number 2
    bindsym $mod+Shift+quotedbl move container to workspace number 3
    bindsym $mod+Shift+apostrophe move container to workspace number 4
    bindsym $mod+Shift+parenleft move container to workspace number 5
    bindsym $mod+Shift+minus move container to workspace number 6
    bindsym $mod+Shift+egrave move container to workspace number 7
    bindsym $mod+Shift+underscore move container to workspace number 8
    bindsym $mod+Shift+ccedilla move container to workspace number 9
    bindsym $mod+Shift+agrave move container to workspace number 10
#
# Layout stuff:
#
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Make the current focus fullscreen
    bindsym $mod+Shift+f fullscreen

    # Toggle focused column full width ↔ 50/50 (strip maximize, not fullscreen)
    bindsym $mod+m exec ~/.config/swirl/scripts/expand.sh

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Tab focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    bindsym --locked XF86AudioMute exec ~/.config/swirl/scripts/volume.sh mute
    bindsym --locked XF86AudioLowerVolume exec ~/.config/swirl/scripts/volume.sh down
    bindsym --locked XF86AudioRaiseVolume exec ~/.config/swirl/scripts/volume.sh up
    bindsym --locked XF86AudioMicMute exec ~/.config/swirl/scripts/volume.sh mic

    bindsym --locked XF86AudioPlay exec ~/.config/swirl/scripts/media.sh play-pause
    bindsym --locked XF86AudioPause exec ~/.config/swirl/scripts/media.sh play-pause
    bindsym --locked XF86AudioPrev exec ~/.config/swirl/scripts/media.sh prev
    bindsym --locked XF86AudioNext exec ~/.config/swirl/scripts/media.sh next
    bindsym --locked XF86AudioStop exec ~/.config/swirl/scripts/media.sh stop

    bindsym --locked XF86MonBrightnessDown exec ~/.config/swirl/scripts/brightness.sh down
    bindsym --locked XF86MonBrightnessUp exec ~/.config/swirl/scripts/brightness.sh up

    bindsym --locked Print exec ~/.config/swirl/scripts/screenshot.sh full
    bindsym $mod+Shift+Print exec ~/.config/swirl/scripts/screenshot.sh region
    # Screen record toggle (region + audio → ~/Videos); press again to stop
    bindsym $mod+Print exec ~/.config/swirl/scripts/record.sh

# ============================================
# Window Decorations - Sweet Potato
# border | background | text | indicator | child_border
# ============================================
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

client.focused           #a73b50 #1d1f21 #ffffff #a73b50 #a73b50
client.focused_inactive  #3a3a3a #1d1f21 #aaaaaa #3a3a3a #3a3a3a
client.unfocused         #3a3a3a #1d1f21 #888888 #3a3a3a #3a3a3a
client.urgent            #f79b29 #f79b29 #1d1f21 #a73b50 #f79b29
client.placeholder       #1d1f21 #1d1f21 #888888 #1d1f21 #1d1f21
client.background        #1d1f21

# ============================================
# Status Bar
# ============================================
bar {
    position top
    status_command ~/.config/swirl/scripts/status.sh
    tray_padding 5
    icon_theme Papirus-Dark
    font pango:Noto Sans 10

    colors {
        statusline #ffffff
        background #1d1f21
        separator  #a73b50

        focused_workspace     #f79b29 #a73b50 #ffffff
        active_workspace      #a73b50 #1d1f21 #ffffff
        inactive_workspace    #1d1f21 #1d1f21 #aaaaaa
        urgent_workspace      #f79b29 #f79b29 #1d1f21
        binding_mode          #f79b29 #f79b29 #1d1f21
    }
}

# Polkit agent for GUI privilege prompts (gnome or xfce)
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Apply GTK/icon/cursor theme (Thunar reads gsettings/xfconf/xsettingsd)
exec ~/.config/swirl/scripts/apply-theme.sh
# Notifications, USB automount, tray applets
exec mako
exec udiskie --tray
exec nm-applet --indicator
exec blueman-applet
exec sh -c 'rfkill unblock bluetooth 2>/dev/null || true'
exec ~/.config/swirl/scripts/tips.sh

# Autostart installer on the live ISO session
exec sh -c 'sleep 5; sweetpotatos-calamares'

# Calamares installer (Wayland app_id)
for_window [app_id="io.calamares.calamares"] floating enable

# nwg-displays saves output layout here; include so it persists across reboots
include ~/.config/nwg-displays/outputs
include /etc/sway/config.d/*
