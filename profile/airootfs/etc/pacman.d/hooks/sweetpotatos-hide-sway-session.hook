# Hide stock Sway session after the sway package lands.
# (Shipping sway.desktop directly in airootfs conflicts during pacstrap.)

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = sway

[Action]
Description = Hiding stock Sway session (SweetPotatOs uses Swirl)...
When = PostTransaction
Depends = sh
Depends = coreutils
Exec = /bin/sh -c 'install -Dm644 /usr/local/share/sweetpotatos/sway.desktop.hide /usr/share/wayland-sessions/sway.desktop'
