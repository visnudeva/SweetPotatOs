# kanshi display profile configuration.
# Kanshi auto-applies these profiles on startup and when monitors change.
#
# To save your current display layout as a profile, run:
#   wlr-randr   (to see output names and current modes)
# Then add a profile block here, e.g.:
#
# profile {
#   output HDMI-A-1 mode 1920x1080 position 0,0 scale 1
#   output eDP-1 mode 1920x1080 position 1920,0 scale 1
# }
#
# Kanshi matches profiles by connected outputs. The wildcard profile below
# applies to any single output at its preferred mode.
profile {
  output * mode preferred position 0,0
}
