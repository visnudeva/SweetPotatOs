    donateUrl:           https://github.com/visnudeva/SweetPotatOs

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

style:
    SidebarBackground:        "#1d1f21"
    SidebarText:              "#FFFFFF"
    SidebarTextCurrent:       "#f79b29"
    SidebarBackgroundCurrent: "#a73b50"

slideshow:     "show.qml"
