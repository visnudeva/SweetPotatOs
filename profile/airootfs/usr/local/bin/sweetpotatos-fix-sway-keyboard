#!/bin/bash
# After Calamares creates the user, select the matching Swirl bind layout
# (config-us / config-fr) from the keyboard page choice.
set -euo pipefail

TARGET_USER="${1:-}"
LAYOUT="${2:-}"
VARIANT="${3:-}"

# Ignore unexpanded Calamares placeholders (older broken confs).
if [[ "${LAYOUT}" == *'gs['* || "${LAYOUT}" == *'${'* ]]; then
  LAYOUT=""
fi
if [[ "${VARIANT}" == *'gs['* || "${VARIANT}" == *'${'* ]]; then
  VARIANT=""
fi

if [[ -z "${TARGET_USER}" || "${TARGET_USER}" == "root" || "${TARGET_USER}" == "liveuser" ]]; then
  echo "sweetpotatos-fix-sway-keyboard: invalid user '${TARGET_USER}'" >&2
  exit 1
fi

HOME_DIR="/home/${TARGET_USER}"
SWIRL_DIR="${HOME_DIR}/.config/swirl"
[[ -d "${SWIRL_DIR}" ]] || exit 0

primary="${LAYOUT%%,*}"
primary="${primary:-us}"

pick=""
case "${primary}" in
  fr) pick="config-fr" ;;
  us) pick="config-us" ;;
esac

sed_escape() {
  # Escape sed replacement specials for delimiter | : \ & |
  local s=$1
  s=${s//\\/\\\\}
  s=${s//&/\\&}
  s=${s//|/\\|}
  printf '%s' "$s"
}

if [[ -n "${pick}" && -f "${SWIRL_DIR}/${pick}" ]]; then
  cp -f "${SWIRL_DIR}/${pick}" "${SWIRL_DIR}/config"
else
  # Unknown layout: keep config, only rewrite xkb_* lines.
  if [[ -n "${LAYOUT}" && -f "${SWIRL_DIR}/config" ]]; then
    esc="$(sed_escape "${LAYOUT}")"
    sed -i "s|^[[:space:]]*xkb_layout[[:space:]]\".*\"|    xkb_layout \"${esc}\"|" "${SWIRL_DIR}/config" || true
  fi
  if [[ -n "${VARIANT}" && -f "${SWIRL_DIR}/config" ]]; then
    escv="$(sed_escape "${VARIANT}")"
    if grep -q '^[[:space:]]*xkb_variant' "${SWIRL_DIR}/config"; then
      sed -i "s|^[[:space:]]*xkb_variant[[:space:]].*|    xkb_variant \"${escv}\"|" "${SWIRL_DIR}/config" || true
    else
      sed -i "/xkb_layout /a\\    xkb_variant \"${escv}\"" "${SWIRL_DIR}/config" || true
    fi
  fi
fi

chown -R "${TARGET_USER}:${TARGET_USER}" "${SWIRL_DIR}" 2>/dev/null || true
echo "sweetpotatos-fix-sway-keyboard: ${TARGET_USER} → layout ${LAYOUT:-us} (${pick:-patched})"
