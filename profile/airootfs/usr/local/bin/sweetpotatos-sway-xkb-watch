#!/bin/bash
# Live session: keep Swirl keyboard layout synced with systemd-localed.
# Calamares applyLocale1() updates locale1 when the user picks a layout; this
# watcher pushes that into the running compositor so password fields etc. match.
#
# Listening with a system-bus monitor tool does not work as liveuser:
# BecomeMonitor is root-only, and the eavesdrop fallback is rejected by dbus-broker,
# so the old watcher applied US once at login and then never saw Calamares layout changes.
set -euo pipefail

LOCK="${XDG_RUNTIME_DIR:-/tmp}/sweetpotatos-xkb-watch.lock"
exec 9>"${LOCK}"
flock -n 9 || exit 0

SYNC="/usr/local/bin/sweetpotatos-sway-xkb-sync"
[[ -x "${SYNC}" ]] || exit 0

fingerprint() {
  local layout variant options
  layout="$(busctl get-property org.freedesktop.locale1 /org/freedesktop/locale1 \
    org.freedesktop.locale1 X11Layout 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')"
  variant="$(busctl get-property org.freedesktop.locale1 /org/freedesktop/locale1 \
    org.freedesktop.locale1 X11Variant 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')"
  options="$(busctl get-property org.freedesktop.locale1 /org/freedesktop/locale1 \
    org.freedesktop.locale1 X11Options 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')"
  printf '%s|%s|%s' "${layout}" "${variant}" "${options}"
}

prev=""
while true; do
  cur="$(fingerprint)"
  if [[ "${cur}" != "${prev}" ]]; then
    "${SYNC}" || true
    prev="${cur}"
  fi
  sleep 0.5
done
